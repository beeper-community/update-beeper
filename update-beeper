# Pure bash arrow-key menu selector
# Returns selected key via stdout
menu_bash() {
    local items=("${MENU_ITEMS[@]}")
    local count=${#items[@]}
    local selected=0
    local current_group=""
    local drawn_lines=0
    local selected_key=""
    local terminal_lines
    terminal_lines=$(tput lines 2>/dev/null || echo 24)
    local compact=false
    (( terminal_lines < count + 10 )) && compact=true

    # Hide cursor, restore on any exit (return, Ctrl+C, kill)
    printf '\033[?25l' >/dev/tty
    trap 'printf "\033[?25h" >/dev/tty' RETURN
    trap 'printf "\033[?25h" >/dev/tty; return 130' INT TERM

    while true; do
        # Redraw exactly the lines printed on the previous pass.
        if (( drawn_lines > 0 )); then
            printf "\033[${drawn_lines}A\r\033[J" >/dev/tty
        fi
        drawn_lines=0

        # Header
        if [[ "$compact" == false ]]; then
            echo -e "" >/dev/tty
            drawn_lines=$((drawn_lines + 1))
        fi
        echo -e "  ${PURPLE}${BOLD}🐝 Beeper Updater${NC} ${INFO}v${SCRIPT_VERSION}${NC}" >/dev/tty
        echo -e "  ${INFO}$(menu_status_line)${NC}" >/dev/tty
        drawn_lines=$((drawn_lines + 2))
        if [[ "$compact" == false ]]; then
            echo -e "" >/dev/tty
            drawn_lines=$((drawn_lines + 1))
        fi

        current_group=""
        local item_index=0

        for item in "${items[@]}"; do
            IFS='|' read -r ikey name desc group <<< "$item"

            # Group separator
            if [[ "$compact" == false && -n "$group" && "$group" != "$current_group" ]]; then
                current_group="$group"
                echo -e "  ${DIM}── ${current_group} ──${NC}" >/dev/tty
                drawn_lines=$((drawn_lines + 1))
            elif [[ "$compact" == false && -z "$group" && -n "$current_group" ]]; then
                current_group=""
                echo -e "  ${DIM}──${NC}" >/dev/tty
                drawn_lines=$((drawn_lines + 1))
            fi

            # Item (highlighted if selected)
            if (( item_index == selected )); then
                printf '  %b▸ %-23s%b %b%s%b\n' "$PURPLE$BOLD" "$name" "$NC" "$INFO" "$desc" "$NC" >/dev/tty
            else
                printf '    %-23s %b%s%b\n' "$name" "$INFO" "$desc" "$NC" >/dev/tty
            fi

            item_index=$((item_index + 1))
            drawn_lines=$((drawn_lines + 1))
        done

        if [[ "$compact" == false ]]; then
            echo -e "" >/dev/tty
            drawn_lines=$((drawn_lines + 1))
        fi
        echo -e "  ${DIM}↑↓ navigate  Enter select  q quit${NC}" >/dev/tty
        drawn_lines=$((drawn_lines + 1))

        # Read keypress
        local input_char
        IFS= read -rsn1 input_char </dev/tty

        case "$input_char" in
            $'\x1b')  # Escape sequence
                read -rsn2 -t 0.1 input_char </dev/tty
                case "$input_char" in
                    '[A') if (( selected > 0 )); then selected=$((selected - 1)); fi ;;
                    '[B') if (( selected < count - 1 )); then selected=$((selected + 1)); fi ;;
                esac
                ;;
            '')  # Enter
                IFS='|' read -r selected_key _ _ _ <<< "${items[$selected]}"
                printf '\033[?25h' >/dev/tty
                echo "$selected_key"
                return 0
                ;;
            'q'|'Q')
                printf '\033[?25h' >/dev/tty
                echo "exit"
                return 0
                ;;
            [0-9])
                # Number shortcuts: 1-9 map to items 0-8, 0 = last (exit)
                local num_target
                if [[ "$input_char" == "0" ]]; then
                    num_target=$(( count - 1 ))
                else
                    num_target=$(( input_char - 1 ))
                fi
                if (( num_target >= 0 && num_target < count )); then
                    selected=$num_target
                    IFS='|' read -r selected_key _ _ _ <<< "${items[$selected]}"
                    printf '\033[?25h' >/dev/tty
                    echo "$selected_key"
                    return 0
                fi
                ;;
        esac
    done
}

