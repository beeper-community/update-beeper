apply_patches() {
    local extract_dir="$1"

    action "Applying patches"
    # Fix AppRun script (same as AUR)
    sed -Ei 's@^(if \[ -z "\$APPDIR" \] ; then)$@APPDIR="/opt/beeper"\n\1@' \
        "$extract_dir/AppRun"

    # Disable auto-update prompts (same as AUR)
    sed -i 's/export{[a-zA-Z0-9_]* as registerLinuxConfig};/const noopFunc=function(){};export{noopFunc as registerLinuxConfig};/' \
        "$extract_dir/resources/app/build/main/linux-"*.mjs 2>/dev/null || true

    pass "Patches applied"
}

install_files() {
    local extract_dir="$1"

    if ! sudo rm -rf "$INSTALL_DIR"; then
        fail "Failed to remove old installation"
        return 1
    fi

    if ! sudo mv "$extract_dir" "$INSTALL_DIR"; then
        fail "Failed to move new installation"
        return 1
    fi

    # Fix ownership and permissions (critical for Electron sandbox)
    if ! sudo chown -R root:root "$INSTALL_DIR"; then
        fail "Failed to set ownership"
        return 1
    fi

    sudo find "$INSTALL_DIR" -type d -exec chmod 755 {} \; 2>/dev/null || true
    sudo chmod 755 "$INSTALL_DIR/beepertexts" 2>/dev/null || true
    sudo chmod 755 "$INSTALL_DIR/AppRun" 2>/dev/null || true
    sudo chmod 755 "$INSTALL_DIR"/*.so 2>/dev/null || true
    sudo chmod 755 "$INSTALL_DIR/chrome_crashpad_handler" 2>/dev/null || true

    if ! sudo chmod 4755 "$INSTALL_DIR/chrome-sandbox"; then
        fail "Failed to set chrome-sandbox setuid"
        return 1
    fi

    # Verify permissions
    if ! verify_permissions "$INSTALL_DIR"; then
        action "Fixing permissions"
        fix_and_retry "permissions" 1
        if ! verify_permissions "$INSTALL_DIR"; then
            return 1
        fi
    fi

    # Update desktop file version (may not exist after direct installs)
    if [[ -f /usr/share/applications/beeper.desktop ]]; then
        sudo sed -i "s/X-AppImage-Version=.*/X-AppImage-Version=$LATEST/" \
            /usr/share/applications/beeper.desktop
    fi

    pass "Files installed with correct permissions"
    return 0
}

cleanup_stale_desktop_files() {
    local stale_files=(
        "$USER_DESKTOP_DIR/beeper.desktop"
        "$USER_DESKTOP_DIR/beepertexts.desktop"
    )

    for f in "${stale_files[@]}"; do
        if [[ -f "$f" ]]; then
            rm -f "$f"
            detail "Removed stale: $(basename "$f")"
        fi
    done
}

setup_wayland_desktop_override() {
    if [[ -z "$WAYLAND_DISPLAY" ]]; then
        return 0
    fi

    mkdir -p "$USER_DESKTOP_DIR"

    # Source: bundled desktop file from AppImage extraction
    local source_desktop="$BUNDLED_DESKTOP"

    if [[ ! -f "$source_desktop" ]]; then
        # Fallback: generate from scratch
        source_desktop=""
    fi

    # Determine Exec line based on wrapper script
    local exec_path="$INSTALL_DIR/beepertexts"
    local exec_line

    if [[ -x "$HOME/bin/beeper-wayland" ]]; then
        # User has a custom wrapper — point to it
        exec_line="$HOME/bin/beeper-wayland %U"
    else
        # No wrapper — use binary directly with Wayland flags
        exec_line="$exec_path $WAYLAND_FLAGS --no-sandbox %U"
    fi

    if [[ -n "$source_desktop" ]]; then
        cp "$source_desktop" "$USER_DESKTOP_FILE"
        # Update Exec line
        sed -i "s|^Exec=.*|Exec=$exec_line|" "$USER_DESKTOP_FILE"
        # Update Name
        sed -i "s|^Name=.*|Name=Beeper|" "$USER_DESKTOP_FILE"
        # Ensure proper MIME types
        sed -i "s|^MimeType=.*|MimeType=x-scheme-handler/beeper;x-scheme-handler/matrix;x-scheme-handler/element;|" "$USER_DESKTOP_FILE"
    else
        # Generate desktop file from scratch
        cat > "$USER_DESKTOP_FILE" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Beeper
GenericName=Unified Messenger
Comment=The ultimate messaging app (Wayland optimized)
Exec=$exec_line
Icon=beepertexts
Terminal=false
StartupWMClass=BeeperTexts
MimeType=x-scheme-handler/beeper;x-scheme-handler/matrix;x-scheme-handler/element;
Categories=Network;InstantMessaging;
Keywords=chat;messaging;whatsapp;telegram;discord;
DESKTOP
    fi

    # Update version metadata
    local installed_version
    installed_version=$(grep -oP '"version":\s*"\K[0-9]+\.[0-9]+\.[0-9]+' \
        "$INSTALL_DIR/resources/app/package.json" 2>/dev/null | head -1)
    if [[ -n "$installed_version" ]]; then
        if grep -q '^X-AppImage-Version=' "$USER_DESKTOP_FILE"; then
            sed -i "s|^X-AppImage-Version=.*|X-AppImage-Version=$installed_version|" "$USER_DESKTOP_FILE"
        else
            echo "X-AppImage-Version=$installed_version" >> "$USER_DESKTOP_FILE"
        fi
    fi

    # Clean up stale desktop files
    cleanup_stale_desktop_files

    update-desktop-database "$USER_DESKTOP_DIR" 2>/dev/null || true

    pass "Desktop entry configured ($USER_DESKTOP_FILE)"
    return 0
}

install_icon() {
    local bundled_icon="$INSTALL_DIR/usr/share/icons/hicolor/512x512/apps/beepertexts.png"
    local user_icon_dir="$HOME/.local/share/icons/hicolor/512x512/apps"
    local user_icon="$user_icon_dir/beepertexts.png"

    if [[ ! -f "$bundled_icon" ]]; then
        warn "Bundled icon not found, skipping icon install"
        return 0
    fi

    mkdir -p "$user_icon_dir"

    if [[ -f "$user_icon" ]] && cmp -s "$bundled_icon" "$user_icon"; then
        return 0  # Already up to date
    fi

    cp "$bundled_icon" "$user_icon"
    gtk-update-icon-cache -f -t "$HOME/.local/share/icons/hicolor" 2>/dev/null || true

    pass "Icon installed (512x512)"
    return 0
}

validate_desktop_entry() {
    local errors=0

    check_reset

    # 1. Desktop file exists
    if [[ -f "$USER_DESKTOP_FILE" ]]; then
        check_add "desktop file" "pass"
    else
        check_add "desktop file" "fail" "not found: $USER_DESKTOP_FILE"
        check_flush
        return 1
    fi

    # 2. Exec binary resolves
    local exec_line
    exec_line=$(grep -m1 '^Exec=' "$USER_DESKTOP_FILE" | sed 's/^Exec=//' | awk '{print $1}')
    if [[ -x "$exec_line" ]]; then
        check_add "exec binary" "pass"
    else
        # Check if it's in PATH
        if command -v "$exec_line" &>/dev/null; then
            check_add "exec binary" "pass"
        else
            check_add "exec binary" "fail" "not found: $exec_line"
            errors=$((errors + 1))
        fi
    fi

    # 3. Exec binary points to correct version
    local desktop_version installed_version
    desktop_version=$(grep -oP 'X-AppImage-Version=\K.*' "$USER_DESKTOP_FILE" 2>/dev/null)
    installed_version=$(grep -oP '"version":\s*"\K[0-9]+\.[0-9]+\.[0-9]+' \
        "$INSTALL_DIR/resources/app/package.json" 2>/dev/null | head -1)

    if [[ -n "$desktop_version" ]] && [[ -n "$installed_version" ]]; then
        if [[ "$desktop_version" == "$installed_version" ]]; then
            check_add "version match" "pass"
        else
            check_add "version match" "warn" "desktop=$desktop_version installed=$installed_version"
        fi
    elif [[ -z "$desktop_version" ]]; then
        check_add "version match" "warn" "no version metadata in desktop file"
    fi

    # 4. Icon resolves
    local icon_name
    icon_name=$(grep -m1 '^Icon=' "$USER_DESKTOP_FILE" | sed 's/^Icon=//')
    if [[ -n "$icon_name" ]]; then
        if echo "$icon_name" | grep -q '/'; then
            # Absolute path
            if [[ -f "$icon_name" ]]; then
                check_add "icon" "pass"
            else
                check_add "icon" "fail" "path not found: $icon_name"
                errors=$((errors + 1))
            fi
        else
            # Theme name — check hicolor
            local found_icon=false
            for size_dir in "$USER_ICON_DIR" "$HOME/.local/share/icons/hicolor"/*/apps /usr/share/icons/hicolor/*/apps; do
                if [[ -f "$size_dir/$icon_name.png" ]] || [[ -f "$size_dir/$icon_name.svg" ]]; then
                    found_icon=true
                    break
                fi
            done
            if [[ "$found_icon" == true ]]; then
                check_add "icon" "pass"
            else
                check_add "icon" "warn" "\"$icon_name\" not found in icon theme — run update-beeper to install"
                errors=$((errors + 1))
            fi
        fi
    fi

    # 5. No stale duplicates
    local stale_count=0
    for f in "$USER_DESKTOP_DIR/beeper.desktop" "$USER_DESKTOP_DIR/beepertexts.desktop"; do
        if [[ -f "$f" ]]; then
            stale_count=$((stale_count + 1))
        fi
    done
    if [[ $stale_count -gt 0 ]]; then
        check_add "stale files" "warn" "$stale_count stale Beeper desktop file(s) found"
    fi

    check_flush

    if [[ $errors -gt 0 ]]; then
        return 1
    fi
    return 0
}

#──────────────────────────────────────────────────────────────────────────────
# MAIN UPDATE LOGIC WITH SELF-HEALING
#──────────────────────────────────────────────────────────────────────────────

do_direct_install() {
    local download_attempt=0
    local appimage="Beeper-${LATEST}-x86_64.AppImage"
    local extract_dir="$TMP_DIR/squashfs-root"
    local retries_list=()

    mkdir -p "$TMP_DIR"
    sudo_keepalive_start

    # Phase 4: Downloading
    next_phase "Downloading Beeper $LATEST"

    # Pre-flight disk space checks
    check_reset
    verify_disk_space "/tmp" "$MIN_FREE_SPACE_MB"
    verify_disk_space "/opt" 1200
    check_flush

    if [[ $_check_failures -gt 0 ]]; then
        hint "sudo rm -rf /tmp/beeper-update /opt/beeper-backups/*"
        return 1
    fi

    # Download & Extract loop with retries
    while [[ $download_attempt -lt $MAX_DOWNLOAD_RETRIES ]]; do
        download_attempt=$((download_attempt + 1))

        local download_http_code
        download_http_code=$(curl -L -f -C - --progress-bar -w "%{http_code}" -o "$TMP_DIR/$appimage" "$DOWNLOAD_URL" 2>/dev/null) || true

        if [[ ! -f "$TMP_DIR/$appimage" ]] || [[ ! -s "$TMP_DIR/$appimage" ]]; then
            fail "Download failed — HTTP $download_http_code"
            retries_list+=("download")
            fix_and_retry "download" $download_attempt
            continue
        fi

        if [[ ! "$download_http_code" =~ ^2[0-9][0-9]$ ]]; then
            fail "Download returned HTTP $download_http_code"
            rm -f "$TMP_DIR/$appimage"
            retries_list+=("download")
            fix_and_retry "download" $download_attempt
            continue
        fi
        chmod +x "$TMP_DIR/$appimage"

        if ! verify_download "$TMP_DIR/$appimage"; then
            fix_and_retry "download" $download_attempt
            continue
        fi

        if ! verify_checksum "$TMP_DIR/$appimage" "$LATEST"; then
            fix_and_retry "download" $download_attempt
            continue
        fi

        # Phase 5: Extracting & verifying
        next_phase "Extracting & verifying"

        local extraction_attempt=0
        local extraction_success=false

        while [[ $extraction_attempt -lt $MAX_EXTRACTION_RETRIES ]]; do
            extraction_attempt=$((extraction_attempt + 1))

            rm -rf "$extract_dir"
            local extract_log="/tmp/beeper-extract-$$.log"
            if (cd "$TMP_DIR" && ./"$appimage" --appimage-extract) >"$extract_log" 2>&1; then
                if verify_extraction "$extract_dir"; then
                    rm -f "$extract_log"
                    extraction_success=true
                    break
                fi
            else
                fail "Extraction command failed"
            fi
            rm -f "$extract_log"

            retries_list+=("extraction")
            fix_and_retry "extraction" $extraction_attempt
        done

        if [[ "$extraction_success" == true ]]; then
            if ! verify_binary_type "$extract_dir/beepertexts"; then
                extraction_success=false
                fix_and_retry "download" $download_attempt
                continue
            fi
            break
        fi

        action "Extraction failed, trying fresh download"
        fix_and_retry "download" $download_attempt
    done

    if ! verify_extraction "$extract_dir" 2>/dev/null; then
        fail "Download/extraction failed after all retries"
        return 1
    fi

    # Phase 6: Installing
    next_phase "Installing"

    if ! apply_patches "$extract_dir"; then
        fail "Patch application failed"
        return 1
    fi

    if ! backup_current; then
        fail "Backup failed — aborting to protect current installation"
        return 1
    fi
    pass "Backup: $ROLLBACK_BACKUP"

    if ! install_files "$extract_dir"; then
        return 1
    fi

    # Phase 7: Configuring
    next_phase "Configuring"

    if ! verify_installed_version "$LATEST"; then
        return 1
    fi

    setup_wayland_desktop_override
    install_icon
    validate_desktop_entry

    # Phase 8: Verifying startup
    next_phase "Verifying startup"

    local startup_attempt=0
    while [[ $startup_attempt -lt $MAX_STARTUP_RETRIES ]]; do
        startup_attempt=$((startup_attempt + 1))

        if verify_beeper_starts; then
            # Track retries for summary
            if [[ ${#retries_list[@]} -gt 0 ]]; then
                local unique_retries
                unique_retries=$(printf '%s\n' "${retries_list[@]}" | sort -u | tr '\n' ', ' | sed 's/,$//')
                RETRIES_USED="${#retries_list[@]} ($unique_retries)"
            fi
            return 0
        fi

        if [[ $startup_attempt -lt $MAX_STARTUP_RETRIES ]]; then
            retries_list+=("startup")
            fix_and_retry "startup" $startup_attempt
        fi
    done

    fail "Startup verification failed after all retries"
    return 1
}

perform_update() {
    local reason="${1:-direct install}"

    # Inform about why we're doing a direct install
    case "$reason" in
        aur-behind) warn "AUR is behind ($AUR < $LATEST) — direct install" ;;
        aur-unknown) warn "AUR version unknown — direct install" ;;
        aur-failed)  warn "AUR install failed — falling back to direct install" ;;
        *)           detail "Direct install" ;;
    esac

    UPDATE_METHOD="Direct install"
    log_event "UPDATE_START from=${INSTALLED:-unknown} to=$LATEST method=direct reason=$reason"

    if do_direct_install; then
        log_event "UPDATE_SUCCESS version=$LATEST method=direct"
        record_update_history "${INSTALLED:-unknown}" "$LATEST" "direct" "success"

        # Prevent pacman desync: remove stale AUR tracking after direct install
        # so omarchy-update (yay -Sua) won't try to update the desynced package
        if [[ "$PACMAN_TRACKED" == true ]]; then
            deregister_pacman_tracking
        fi

        summary_box "success"

        [[ "$NOTIFY" == true ]] && send_notification "Updated to $LATEST"
        return 0
    else
        log_event "UPDATE_FAILED to=$LATEST method=direct"

        if rollback_to_backup; then
            log_event "ROLLBACK_SUCCESS"
            record_update_history "${INSTALLED:-unknown}" "$LATEST" "direct" "rolled-back"
            summary_box "failure" "Rolled back to previous version"
            [[ "$NOTIFY" == true ]] && send_notification "Update to $LATEST failed - rolled back"
        else
            record_update_history "${INSTALLED:-unknown}" "$LATEST" "direct" "failed"
            summary_box "failure" "Rollback also failed — manual fix needed"
            [[ "$NOTIFY" == true ]] && send_notification "Update to $LATEST failed - rollback also failed!"
        fi
        return 1
    fi
}

#──────────────────────────────────────────────────────────────────────────────
# MAIN ENTRY POINT
#──────────────────────────────────────────────────────────────────────────────

# Acquire lock early (prevents concurrent runs)
acquire_lock

# Verify system compatibility first
check_system_compatibility

# Handle changelog display (early exit)
if [[ "$SHOW_CHANGELOG" == true ]]; then
    show_changelog
    exit $?
fi

# Handle versions display (early exit)
if [[ "$SHOW_VERSIONS" == true ]]; then
    show_versions
fi

# Handle desktop validation (early exit)
if [[ "$CHECK_DESKTOP" == true ]]; then
    print_header
    phase 1 1 "Desktop entry validation"
    validate_desktop_entry
    exit $?
fi

# Handle manual rollback request
if [[ "$DO_ROLLBACK" == true ]]; then
    print_header
    action "Manual rollback requested"
    if rollback_to_backup; then
        pass "Rollback completed"
        exit 0
    else
        fail "Rollback failed"
        exit 1
    fi
fi

# ── Begin update flow ──────────────────────────────────────────────────────

print_header
log_event "SESSION_START version=$SCRIPT_VERSION"

# Phase 1: Checking versions
TOTAL_STEPS=8
next_phase "Checking versions"
check_versions

detail "Installed: ${BOLD}${INSTALLED:-unknown}${NC}"
detail "Latest:    ${BOLD}${LATEST:-unknown}${NC}"
if [[ "$AUR" != "unknown" ]]; then
    detail "AUR:       ${AUR}"
fi
if [[ "$PACMAN_TRACKED" == true ]]; then
    detail "Pacman:    tracked"
else
    detail "Pacman:    untracked (--overwrite will be used)"
fi

log_event "VERSIONS installed=${INSTALLED:-unknown} latest=${LATEST:-unknown} aur=${AUR:-unknown} pacman=$PACMAN_TRACKED"

# Validate we got version info
if [[ -z "$LATEST" || "$LATEST" == "unknown" ]]; then
    fail "Could not determine latest version from Beeper API"
    log_event "ABORT reason=latest_version_unknown"
    exit 1
fi

# Compare versions
if [[ "$FORCE" != true ]] && version_gte "$INSTALLED" "$LATEST"; then
    pass "Already on the latest version (${INSTALLED})"
    log_event "UP_TO_DATE version=$INSTALLED"
    log ""
    exit 0
fi

log ""
log "  ${WARN}${BOLD}Update available:${NC} ${INSTALLED:-unknown} → ${BOLD}$LATEST${NC}"

# Check-only mode
if [[ "$CHECK_ONLY" == true ]]; then
    [[ "$NOTIFY" == true ]] && send_notification "Update available: ${INSTALLED:-unknown} → $LATEST"
    exit 0
fi

# Phase 2: Validating source
next_phase "Validating source"
if [[ -n "$DOWNLOAD_URL" ]]; then
    validate_download_url "$DOWNLOAD_URL"
else
    fail "No download URL resolved from Beeper API"
    log_event "ABORT reason=no_download_url"
    exit 1
fi

# Dry-run mode: show what would happen without doing anything
if [[ "$DRY_RUN" == true ]]; then
    log ""
    log "  ${INFO}╭──────────────────────────────────────╮${NC}"
    pad_row "${ACCENT}${BOLD}Dry run${NC} — no changes"
    log "  ${INFO}│${NC}$(printf '%*s' 39 '')${INFO}│${NC}"
    pad_row "${ACCENT}Version${NC}   ${INSTALLED:-unknown} → $LATEST"
    if [[ "$AUR" != "unknown" ]] && version_gte "$AUR" "$LATEST"; then
        pad_row "${ACCENT}Method${NC}    AUR (yay)"
    elif [[ "$AUR" != "unknown" ]]; then
        pad_row "${ACCENT}Method${NC}    Direct install (AUR behind)"
    else
        pad_row "${ACCENT}Method${NC}    Direct install"
    fi
    pad_row "${ACCENT}Pacman${NC}    $(if [[ "$PACMAN_TRACKED" == true ]]; then echo "tracked"; else echo "untracked"; fi)"
    pad_row "${ACCENT}Backup${NC}    $BACKUP_DIR"
    log "  ${INFO}╰──────────────────────────────────────╯${NC}"
    log ""
    hint "Run without --dry-run to perform the update."
    log_event "DRY_RUN from=${INSTALLED:-unknown} to=$LATEST"
    exit 0
fi

# Phase 3: Checking prerequisites
next_phase "Checking prerequisites"
check_reset

if ! verify_sudo_access; then
    check_flush
    fail "Cannot proceed without sudo access"
    exit 1
fi

if ! verify_system_requirements; then
    check_flush
    fail "System requirements not met"
    exit 1
fi

# Disk space check
verify_disk_space "/opt" 1200

check_flush

# Pre-flight permissions fix
if [[ -d "$INSTALL_DIR" ]]; then
    if ! verify_permissions "$INSTALL_DIR"; then
        action "Fixing installation permissions"
        fix_and_retry "permissions" 1
        if verify_permissions "$INSTALL_DIR"; then
            pass "Permissions fixed"
        else
            warn "Could not fix permissions — proceeding anyway"
        fi
    fi
fi

# Try AUR first if it has the latest
if [[ "$AUR" != "unknown" ]] && version_gte "$AUR" "$LATEST"; then
    TOTAL_STEPS=4
    CURRENT_STEP=3
    next_phase "Updating via AUR"
    UPDATE_METHOD="AUR (yay)"
    log_event "AUR_ATTEMPT version=$AUR"

    if yay -S --noconfirm --overwrite '/opt/beeper/*' beeper-v4-bin; then
        pass "Installed $LATEST via AUR"
        log_event "AUR_SUCCESS version=$LATEST"
        record_update_history "${INSTALLED:-unknown}" "$LATEST" "aur" "success"

        setup_wayland_desktop_override

        if verify_beeper_starts; then
            summary_box "success"
            exit 0
        else
            action "Clearing Electron cache"
            clear_electron_cache
            sleep 2
            if verify_beeper_starts; then
                summary_box "success"
                exit 0
            else
                summary_box "failure" "Try: update-beeper --force"
                exit 1
            fi
        fi
    else
        warn "AUR install failed — falling back to direct install"
        log_event "AUR_FAILED falling_back=direct"
        # Reset step counter for direct install (8 steps, phases 4-8 in do_direct_install)
        TOTAL_STEPS=8
        CURRENT_STEP=3
    fi
fi

# Determine reason for direct install
DIRECT_REASON="direct"
if [[ "$AUR" == "unknown" ]]; then
    DIRECT_REASON="aur-unknown"
elif ! version_gte "$AUR" "$LATEST"; then
    DIRECT_REASON="aur-behind"
else
    DIRECT_REASON="aur-failed"
fi

# Direct install with self-healing
if perform_update "$DIRECT_REASON"; then
    log_event "SESSION_END status=success"
    exit 0
else
    log_event "SESSION_END status=failed"
    exit 1
fi
