#!/bin/bash
# ~/bin/update-beeper - Smart Beeper updater with self-healing
# Features: auto-retry, self-healing, health checks, automatic rollback

set -e

SCRIPT_VERSION="1.8.0"
LOCKFILE="/tmp/update-beeper.lock"
BEEPER_API="https://api.beeper.com/desktop/download/linux/x64/stable/com.automattic.beeper.desktop"
CHANGELOG_URL="https://www.beeper.com/changelog/desktop"
INSTALL_DIR="/opt/beeper"
BACKUP_DIR="/opt/beeper-backups"
TMP_DIR="/tmp/beeper-update"
BEEPER_CONFIG="$HOME/.config/BeeperTexts"
USER_DESKTOP_DIR="$HOME/.local/share/applications"
USER_DESKTOP_FILE="$USER_DESKTOP_DIR/beeper-wayland.desktop"
BUNDLED_DESKTOP="$INSTALL_DIR/beepertexts.desktop"
USER_ICON_DIR="$HOME/.local/share/icons/hicolor/512x512/apps"

# Wayland flags for native rendering (fixes blank windows on Hyprland/Sway)
# --disable-gpu-compositing prevents blank screen after sleep/wake cycles
WAYLAND_FLAGS="--enable-features=UseOzonePlatform --ozone-platform=wayland --disable-gpu-compositing"

# Minimum expected AppImage size (Beeper is ~200MB)
MIN_APPIMAGE_SIZE=150000000  # 150MB

# Checksum cache for trust-on-first-run verification
CHECKSUM_CACHE="$HOME/.cache/update-beeper/checksums.txt"

# Persistent log and update history
LOG_FILE="$HOME/.local/share/update-beeper/update-beeper.log"
HISTORY_FILE="$HOME/.local/share/update-beeper/update-history.log"

# Minimum required free space (500MB for download + extraction + buffer)
MIN_FREE_SPACE_MB=500

# Retry limits
MAX_DOWNLOAD_RETRIES=2
MAX_EXTRACTION_RETRIES=2
MAX_STARTUP_RETRIES=2

# Runtime dependencies that Beeper needs but pacman won't track after
# deregistration. Without this, orphan cleanup (pacman -Rns $(pacman -Qdtq))
# can silently remove these, breaking tray icons, notifications, etc.
BEEPER_RUNTIME_DEPS=(libappindicator libnotify libsecret hicolor-icon-theme)

# ── Beeper Brand Colors (True Color) ─────────────────────────────────────
# Primary brand: purple #6953f2, secondary: blue #0c52f9
if [[ "$COLORTERM" == "truecolor" || "$COLORTERM" == "24bit" ]]; then
    PURPLE='\033[38;2;105;83;242m'      # #6953f2 Beeper primary
    BLUE='\033[38;2;12;82;249m'         # #0c52f9 Beeper secondary
    OK='\033[38;2;80;200;120m'          # #50c878 muted emerald (success)
    ERR='\033[38;2;235;87;87m'          # #eb5757 soft red (errors)
    WARN='\033[38;2;242;201;76m'        # #f2c94c warm amber (warnings)
    INFO='\033[38;2;130;130;160m'       # #8282a0 lavender-gray (dim info)
    ACCENT='\033[38;2;160;140;255m'     # #a08cff light purple (labels)
else
    # 256-color fallback
    PURPLE='\033[38;5;99m'
    BLUE='\033[38;5;27m'
    OK='\033[38;5;78m'
    ERR='\033[38;5;167m'
    WARN='\033[38;5;220m'
    INFO='\033[38;5;103m'
    ACCENT='\033[38;5;141m'
fi
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'



# Flags
CHECK_ONLY=false
NOTIFY=false
FORCE=false
SHOW_CHANGELOG=false
QUIET=false
DO_ROLLBACK=false
SCRIPT_EXIT_CODE=0
SHOW_VERSIONS=false
SKIP_CHECKSUM=false
DRY_RUN=false
CHECK_DESKTOP=false

# Track which backup to use for rollback
ROLLBACK_BACKUP=""

usage() {
    echo "Usage: update-beeper [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --check, -c       Check for updates without installing"
    echo "  --changelog, -l   Show changelog for installed version"
    echo "  --notify, -n      Send desktop notification (for cron/timer use)"
    echo "  --force, -f       Force update even if already on latest"
    echo "  --quiet, -q       Quiet mode - only output on errors (for cron/systemd)"
    echo "  --versions        Show all version info (installed, latest, AUR)"
    echo "  --skip-checksum   Skip SHA256 checksum verification (for forced re-downloads)"
    echo "  --dry-run         Show what would happen without making changes"
    echo "  --history         Show update history"
    echo "  --check-desktop   Validate Beeper desktop shortcut and icon"
    echo "  --rollback, -r    Rollback to previous backup version"
    echo "  --version, -v     Show script version"
    echo "  --help, -h        Show this help message"
    echo ""
    echo "Beeper will automatically restart after updating."
    echo "If update fails, automatic rollback will restore the previous version."
    echo ""
    echo "Wayland Support:"
    echo "  On Wayland (Hyprland, Sway, etc.), this script automatically:"
    echo "  - Creates ~/.local/share/applications/beeper-wayland.desktop"
    echo "  - Installs icon to hicolor theme for launcher display"
    echo "  - Validates desktop entry points to correct binary and version"
    echo "  - Cleans up stale Beeper shortcuts"
    exit 0
}

show_version() {
    echo "update-beeper $SCRIPT_VERSION"
    exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --check|-c) CHECK_ONLY=true; shift ;;
        --changelog|-l) SHOW_CHANGELOG=true; shift ;;
        --notify|-n) NOTIFY=true; shift ;;
        --force|-f) FORCE=true; shift ;;
        --quiet|-q) QUIET=true; shift ;;
        --versions) SHOW_VERSIONS=true; shift ;;
        --skip-checksum) SKIP_CHECKSUM=true; shift ;;
        --dry-run) DRY_RUN=true; shift ;;
        --history) cat "$HISTORY_FILE" 2>/dev/null || echo "No update history yet."; exit 0 ;;
        --check-desktop) CHECK_DESKTOP=true; shift ;;
        --rollback|-r) DO_ROLLBACK=true; shift ;;
        --version|-v) show_version ;;
        --help|-h) usage ;;
        *) echo "Unknown option: $1"; usage ;;
    esac
done

cleanup() {
    sudo_keepalive_stop
    rm -rf "$TMP_DIR" 2>/dev/null || true
    release_lock
}
trap cleanup EXIT

#──────────────────────────────────────────────────────────────────────────────
# LOCKFILE MANAGEMENT
#──────────────────────────────────────────────────────────────────────────────

acquire_lock() {
    # Use file descriptor 9 for the lock
    exec 9>"$LOCKFILE"
    if ! flock -n 9; then
        local other_pid
        other_pid=$(cat "$LOCKFILE" 2>/dev/null || echo "unknown")
        fail "Another update-beeper is already running (PID: $other_pid)"
        exit 1
    fi
    echo $$ > "$LOCKFILE"
}

release_lock() {
    flock -u 9 2>/dev/null || true
    rm -f "$LOCKFILE" 2>/dev/null || true
}

#──────────────────────────────────────────────────────────────────────────────
# OUTPUT HELPERS (for quiet mode)
#──────────────────────────────────────────────────────────────────────────────

# Print only if not in quiet mode
log() {
    [[ "$QUIET" != true ]] && echo -e "$@" || true
}

# Always print (errors)
log_error() {
    echo -e "$@" >&2
}

#──────────────────────────────────────────────────────────────────────────────
# UI SYSTEM — Beeper-branded output hierarchy
#──────────────────────────────────────────────────────────────────────────────

# Step counter for progress tracking
CURRENT_STEP=0
TOTAL_STEPS=8
START_TIME=$SECONDS
UPDATE_METHOD=""
RETRIES_USED=""

print_header() {
    log ""
    log "  ${PURPLE}${BOLD}🐝 Beeper Updater${NC} ${INFO}v${SCRIPT_VERSION}${NC}"
    log ""
}

# Phase header: [n/N] Title
phase() {
    local step="$1" total="$2" title="$3"
    log ""
    log "  ${PURPLE}${BOLD}[${step}/${total}]${NC} ${BOLD}${title}${NC}"
}

next_phase() {
    CURRENT_STEP=$((CURRENT_STEP + 1))
    phase "$CURRENT_STEP" "$TOTAL_STEPS" "$1"
}

# Sub-step results (4-space indent)
pass()   { log "    ${OK}✓${NC} $1"; }
fail()   { log_error "    ${ERR}✗${NC} $1"; }
warn()   { log "    ${WARN}!${NC} $1"; }
detail() { log "    ${INFO}$1${NC}"; }
action() { log "    ${ACCENT}→${NC} $1"; }
hint()   { log "      ${INFO}$1${NC}"; }

#──────────────────────────────────────────────────────────────────────────────
# COLLAPSIBLE CHECK GROUPS
#──────────────────────────────────────────────────────────────────────────────

declare -a _check_results=()
declare -a _check_names=()
_check_failures=0

check_reset() {
    _check_results=()
    _check_names=()
    _check_failures=0
}

check_add() {
    local name="$1" status="$2" msg="${3:-}"
    _check_names+=("$name")
    _check_results+=("${status}|${name}|${msg}")
    if [[ "$status" == "fail" ]]; then
        _check_failures=$((_check_failures + 1))
    fi
}

check_flush() {
    if [[ $_check_failures -eq 0 && ${#_check_results[@]} -gt 2 ]]; then
        # Collapse: all passed
        local names_joined
        names_joined=$(IFS=', '; echo "${_check_names[*]}")
        pass "All ${#_check_results[@]} checks passed (${names_joined})"
    else
        # Expand: show each
        local entry status name msg
        for entry in "${_check_results[@]}"; do
            IFS='|' read -r status name msg <<< "$entry"
            case "$status" in
                pass) pass "$name" ;;
                warn) warn "$name${msg:+ — $msg}" ;;
                fail) fail "$name${msg:+ — $msg}" ;;
            esac
        done
    fi
    check_reset
}

#──────────────────────────────────────────────────────────────────────────────
# SUMMARY BOX
#──────────────────────────────────────────────────────────────────────────────

# Pad a row to fit inside the summary box (42 chars inner width)
pad_row() {
    local content="$1"
    local width=38
    # Strip ANSI codes to count visible chars
    local visible
    visible=$(echo -e "$content" | sed 's/\x1b\[[0-9;]*m//g')
    local vlen=${#visible}
    local pad=$((width - vlen))
    [[ $pad -lt 0 ]] && pad=0
    log "  ${INFO}│${NC} ${content}$(printf '%*s' "$pad" '') ${INFO}│${NC}"
}

summary_box() {
    local status="$1"  # "success" or "failure"
    local elapsed=$((SECONDS - START_TIME))
    local duration
    if [[ $elapsed -ge 60 ]]; then
        duration="$((elapsed / 60))m $((elapsed % 60))s"
    else
        duration="${elapsed}s"
    fi

    log ""
    log "  ${INFO}╭──────────────────────────────────────╮${NC}"

    if [[ "$status" == "success" ]]; then
        pad_row "${OK}${BOLD}✓ Update complete${NC}"
    else
        pad_row "${ERR}${BOLD}✗ Update failed${NC}"
    fi

    log "  ${INFO}│${NC}$(printf '%*s' 39 '')${INFO}│${NC}"
    pad_row "${ACCENT}Version${NC}   ${INSTALLED:-?} → ${LATEST}"
    pad_row "${ACCENT}Method${NC}    ${UPDATE_METHOD:-Direct install}"
    pad_row "${ACCENT}Duration${NC}  ${duration}"

    if [[ -n "$RETRIES_USED" ]]; then
        pad_row "${ACCENT}Retries${NC}   ${RETRIES_USED}"
    fi

    # Wayland row (only on Wayland)
    if [[ -n "$WAYLAND_DISPLAY" ]]; then
        pad_row "${ACCENT}Wayland${NC}   Configured"
    fi

    # Desktop entry status
    if [[ -f "$USER_DESKTOP_FILE" ]]; then
        pad_row "${ACCENT}Desktop${NC}   $(basename "$USER_DESKTOP_FILE")"
    fi

    # Rollback row (only on failure with rollback)
    if [[ "$status" == "failure" && -n "$2" ]]; then
        pad_row "${ACCENT}Action${NC}    $2"
    fi

    log "  ${INFO}╰──────────────────────────────────────╯${NC}"
    log ""
}

# Persistent log file (fire-and-forget, never fails the script)
log_event() {
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE" 2>/dev/null || true
}

# Record update in history file
record_update_history() {
    local from_version="$1"
    local to_version="$2"
    local method="$3"    # "aur" or "direct"
    local status="$4"    # "success" or "failed" or "rolled-back"
    mkdir -p "$(dirname "$HISTORY_FILE")" 2>/dev/null || true
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $from_version → $to_version ($method) [$status]" >> "$HISTORY_FILE" 2>/dev/null || true
}

#──────────────────────────────────────────────────────────────────────────────
# SUDO KEEPALIVE (prevents timeout during long downloads)
#──────────────────────────────────────────────────────────────────────────────

SUDO_KEEPALIVE_PID=""

sudo_keepalive_start() {
    ( while true; do sudo -v 2>/dev/null; sleep 50; done ) &
    SUDO_KEEPALIVE_PID=$!
}

sudo_keepalive_stop() {
    if [[ -n "${SUDO_KEEPALIVE_PID}" ]]; then
        kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
        wait "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
        SUDO_KEEPALIVE_PID=""
    fi
}

#──────────────────────────────────────────────────────────────────────────────
# SYSTEM COMPATIBILITY CHECKS
#──────────────────────────────────────────────────────────────────────────────

check_architecture() {
    local arch
    arch=$(uname -m)
    if [[ "$arch" != "x86_64" ]]; then
        fail "Unsupported architecture: $arch"
        hint "Beeper Desktop only provides x86_64 (64-bit) builds"
        exit 1
    fi
}

check_distro() {
    if ! command -v pacman &>/dev/null; then
        warn "Designed for Arch Linux — pacman not found"
        hint "AUR features won't be available"
    fi
}

check_dependencies() {
    local missing=()

    for cmd in curl sudo; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        fail "Missing required dependencies: ${missing[*]}"
        hint "Install with: sudo pacman -S ${missing[*]}"
        exit 1
    fi

    if ! command -v notify-send &>/dev/null; then
        if [[ "$NOTIFY" == true ]]; then
            NOTIFY=false
        fi
    fi
}

check_system_compatibility() {
    check_architecture
    check_distro
    check_dependencies
}

#──────────────────────────────────────────────────────────────────────────────
# UTILITY FUNCTIONS
#──────────────────────────────────────────────────────────────────────────────

# Version comparison: returns 0 if $1 >= $2
version_gte() {
    printf '%s\n%s\n' "$2" "$1" | sort -V -C
}

send_notification() {
    if command -v notify-send &>/dev/null; then
        notify-send -i beepertexts "Beeper Update" "$1"
    fi
}

show_changelog() {
    # Get installed version
    local version=""
    if [[ -f "$INSTALL_DIR/resources/app/package.json" ]]; then
        version=$(grep -oP '"version":\s*"\K[0-9]+\.[0-9]+\.[0-9]+' "$INSTALL_DIR/resources/app/package.json" | head -1)
    fi

    if [[ -z "$version" ]]; then
        fail "Could not determine installed Beeper version"
        return 1
    fi

    print_header
    log "  ${ACCENT}Changelog${NC} for ${BOLD}$version${NC}"
    log ""
    detail "Opening in browser..."

    # Open changelog in default browser
    if command -v xdg-open &>/dev/null; then
        xdg-open "$CHANGELOG_URL" 2>/dev/null &
    elif command -v open &>/dev/null; then
        open "$CHANGELOG_URL" 2>/dev/null &
    else
        warn "Could not open browser automatically"
        detail "Visit: ${CHANGELOG_URL}"
    fi

    log ""
    hint "Search for '$version' on the page to find your version's changes"
    return 0
}

check_versions() {
    # Get installed version - ALWAYS check package.json first (source of truth)
    # pacman may show AUR version which lags behind direct installs
    INSTALLED=""
    if [[ -f "$INSTALL_DIR/resources/app/package.json" ]]; then
        INSTALLED=$(grep -oP '"version":\s*"\K[0-9]+\.[0-9]+\.[0-9]+' "$INSTALL_DIR/resources/app/package.json" | head -1)
    fi

    # Fallback to pacman only if package.json missing (fresh install scenario)
    if [[ -z "$INSTALLED" ]]; then
        INSTALLED=$(pacman -Q beeper-v4-bin 2>/dev/null | awk '{print $2}' | cut -d'-' -f1)
    fi

    # Get latest version from API (SINGLE curl call for both status + URL)
    # Sets globals: DOWNLOAD_URL, LATEST, AUR
    local api_response
    api_response=$(curl -Ls -m 10 -o /dev/null -w "%{http_code}\n%{url_effective}" "$BEEPER_API" 2>/dev/null)
    local http_status
    http_status=$(echo "$api_response" | head -1)
    DOWNLOAD_URL=$(echo "$api_response" | tail -1)

    if [[ "$http_status" != "200" ]] && [[ "$http_status" != "302" ]] && [[ "$http_status" != "301" ]]; then
        echo -e "${ERR}    ✗ Beeper API returned HTTP $http_status${NC}" >&2
        LATEST="unknown"
        DOWNLOAD_URL=""
    else
        LATEST=$(echo "$DOWNLOAD_URL" | grep -oP 'Beeper-\K[0-9]+\.[0-9]+\.[0-9]+')

        # Validate LATEST extraction - if empty, API redirect may have failed
        if [[ -z "$LATEST" ]]; then
            # Try alternative: extract from any version pattern in URL
            LATEST=$(echo "$DOWNLOAD_URL" | grep -oP '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
        fi
        if [[ -z "$LATEST" ]]; then
            LATEST="unknown"
        fi
    fi

    # Get AUR version via JSON RPC API (structured, no HTML scraping)
    local aur_json
    aur_json=$(curl -sL -m 10 "https://aur.archlinux.org/rpc/v5/info?arg[]=beeper-v4-bin" 2>/dev/null)
    if [[ -n "$aur_json" ]] && echo "$aur_json" | grep -q '"resultcount":1'; then
        AUR=$(echo "$aur_json" | grep -oP '"Version"\s*:\s*"\K[0-9]+\.[0-9]+\.[0-9]+')
        if [[ -z "$AUR" ]]; then
            AUR="unknown"
        fi
    else
        echo -e "${WARN}    ! AUR RPC returned no results${NC}" >&2
        AUR="unknown"
    fi

    # Check if beeper is tracked by pacman (affects AUR update path)
    PACMAN_TRACKED=false
    if pacman -Q beeper-v4-bin &>/dev/null; then
        PACMAN_TRACKED=true
    fi
}

#──────────────────────────────────────────────────────────────────────────────
# PACMAN DESYNC PREVENTION
#──────────────────────────────────────────────────────────────────────────────

# After a direct install, pacman's database still tracks beeper-v4-bin at
# the old AUR version. This desync causes omarchy-update (yay -Sua) to
# attempt updating a package whose on-disk files don't match, potentially
# blocking the entire system update.
#
# Strategy: move installed files aside, let pacman -Rdd remove the stale
# database entry (it won't find files to delete), then restore our files.

deregister_pacman_tracking() {
    if ! pacman -Q beeper-v4-bin &>/dev/null; then
        return 0  # Already untracked, nothing to do
    fi

    local pacman_version
    pacman_version=$(pacman -Q beeper-v4-bin 2>/dev/null | awk '{print $2}' | cut -d'-' -f1)
    action "Deregistering stale pacman entry (tracked: ${pacman_version}, actual: ${LATEST})"

    # 1. Move our direct-install files to a safe location
    if ! sudo mv "$INSTALL_DIR" "${INSTALL_DIR}-deregister-tmp" 2>/dev/null; then
        warn "Could not move $INSTALL_DIR aside — skipping deregistration"
        hint "Run manually: sudo pacman -Rdd beeper-v4-bin && sudo mv ${INSTALL_DIR}-deregister-tmp ${INSTALL_DIR}"
        return 1
    fi

    # 2. Remove pacman tracking (files already moved, so nothing gets deleted)
    if sudo pacman -Rdd --noconfirm beeper-v4-bin 2>/dev/null; then
        pass "Pacman tracking removed"
    else
        warn "pacman -Rdd failed — restoring files"
        sudo mv "${INSTALL_DIR}-deregister-tmp" "$INSTALL_DIR" 2>/dev/null
        return 1
    fi

    # 3. Restore our files
    if sudo mv "${INSTALL_DIR}-deregister-tmp" "$INSTALL_DIR" 2>/dev/null; then
        pass "Files restored"
        PACMAN_TRACKED=false
        log_event "PACMAN_DEREGISTERED old_version=$pacman_version"
        preserve_runtime_deps
    else
        # Critical: files exist but at wrong path
        fail "Could not restore files from ${INSTALL_DIR}-deregister-tmp"
        hint "Run: sudo mv ${INSTALL_DIR}-deregister-tmp ${INSTALL_DIR}"
        return 1
    fi

    return 0
}

# ── Preserve runtime deps after pacman deregistration ────────────────────
# When we remove beeper-v4-bin from pacman's DB, its dependencies become
# orphans (install reason = "dependency" with no dependents). The next
# `pacman -Rns $(pacman -Qdtq)` or similar orphan cleanup will silently
# remove them, breaking tray icons, notifications, keyring, etc.
#
# Fix: mark each dep as "explicitly installed" — a DB-only operation that
# costs nothing but prevents orphan cleanup from touching them.

preserve_runtime_deps() {
    local dep preserved=0 skipped=0

    for dep in "${BEEPER_RUNTIME_DEPS[@]}"; do
        if ! pacman -Q "$dep" &>/dev/null; then
            # Not installed — nothing to preserve
            (( skipped++ ))
            continue
        fi

        local reason
        reason=$(pacman -Qi "$dep" 2>/dev/null | awk -F': ' '/Install Reason/{print $2}')

        if [[ "$reason" == *"Explicitly"* ]]; then
            # Already explicit — safe from orphan cleanup
            (( skipped++ ))
            continue
        fi

        # Mark as explicitly installed (DB-only, no download/reinstall)
        if sudo pacman -D --asexplicit "$dep" &>/dev/null; then
            (( preserved++ ))
        else
            warn "Could not mark $dep as explicit — may be removed by orphan cleanup"
        fi
    done

    if (( preserved > 0 )); then
        pass "Preserved $preserved runtime dep(s) from orphan cleanup"
        log_event "RUNTIME_DEPS_PRESERVED count=$preserved"
    fi
}

#──────────────────────────────────────────────────────────────────────────────
# URL SECURITY VALIDATION
#──────────────────────────────────────────────────────────────────────────────

# Trusted domains for Beeper downloads (pipe-separated for grep -E)
TRUSTED_DOMAINS="beeper\.com|todesktop\.com|github\.com"

validate_download_url() {
    local url="$1"
    local domain

    # Extract domain from URL (handles both http and https)
    domain=$(echo "$url" | sed -E 's|https?://([^/]+).*|\1|')

    # Check if domain matches trusted patterns (including subdomains)
    if ! echo "$domain" | grep -qE "(^|\.)(${TRUSTED_DOMAINS})$"; then
        fail "SECURITY: Untrusted download domain: $domain"
        hint "Expected: beeper.com, todesktop.com, or github.com"
        hint "Got URL: $url"
        hint "This could indicate a MITM attack or API change"
        exit 1
    fi
    pass "Domain verified: $domain"
}

show_versions() {
    check_versions

    print_header
    log ""
    log "  ${ACCENT}Installed${NC}  ${BOLD}${INSTALLED:-unknown}${NC}"
    log "  ${ACCENT}Latest${NC}     ${BOLD}${LATEST:-unknown}${NC}"
    log "  ${ACCENT}AUR${NC}        ${INFO}${AUR:-unknown}${NC}"
    if [[ "$PACMAN_TRACKED" == true ]]; then
        log "  ${ACCENT}Pacman${NC}     ${OK}tracked${NC}"
    else
        log "  ${ACCENT}Pacman${NC}     ${WARN}untracked${NC}"
    fi
    log ""

    if [[ -n "$INSTALLED" ]] && [[ "$INSTALLED" != "unknown" ]] && \
       [[ -n "$LATEST" ]] && [[ "$LATEST" != "unknown" ]]; then
        if version_gte "$INSTALLED" "$LATEST"; then
            pass "On the latest version"
        else
            warn "Update available: $INSTALLED → $LATEST"
        fi
    fi

    if [[ -n "$AUR" ]] && [[ "$AUR" != "unknown" ]] && \
       [[ -n "$LATEST" ]] && [[ "$LATEST" != "unknown" ]] && \
       ! version_gte "$AUR" "$LATEST"; then
        hint "AUR is behind (update-beeper uses direct download)"
    fi
    log ""

    exit 0
}

#──────────────────────────────────────────────────────────────────────────────
# VERIFICATION FUNCTIONS
#──────────────────────────────────────────────────────────────────────────────

verify_sudo_access() {
    if ! sudo -v 2>/dev/null; then
        fail "sudo access required"
        hint "Run with sudo privileges or ensure sudo is configured"
        return 1
    fi
    check_add "sudo" "pass"
    return 0
}

verify_system_requirements() {
    local errors=0

    # Network connectivity
    if ! curl -s --connect-timeout 5 --head https://api.beeper.com >/dev/null 2>&1; then
        check_add "network" "fail" "Cannot reach Beeper servers"
        errors=$((errors + 1))
    else
        check_add "network" "pass"
    fi

    # /opt writable (with sudo)
    if ! sudo test -w /opt 2>/dev/null; then
        check_add "/opt" "fail" "not writable"
        errors=$((errors + 1))
    else
        check_add "/opt" "pass"
    fi

    # /tmp writable
    if ! test -w /tmp; then
        check_add "/tmp" "fail" "not writable"
        errors=$((errors + 1))
    else
        check_add "/tmp" "pass"
    fi

    # Required commands
    local required_cmds=("curl" "stat" "grep" "sed" "tar")
    for cmd in "${required_cmds[@]}"; do
        if ! command -v "$cmd" &>/dev/null; then
            check_add "$cmd" "fail" "not found"
            errors=$((errors + 1))
        fi
    done

    # Beeper running (warn only, doesn't count as error)
    if pgrep -x "beepertexts" >/dev/null; then
        check_add "beeper" "warn" "running, will restart after update"
    fi

    if [[ $errors -gt 0 ]]; then
        return 1
    fi
    return 0
}

verify_permissions() {
    local install_dir="$1"
    local errors=0

    if [[ ! -d "$install_dir" ]]; then
        fail "Install directory not found: $install_dir"
        return 1
    fi

    # Ownership (root:root)
    local owner
    owner=$(stat -c '%U:%G' "$install_dir" 2>/dev/null)
    [[ "$owner" != "root:root" ]] && errors=$((errors + 1))

    # Directory permissions (755)
    local dir_perms
    dir_perms=$(stat -c '%a' "$install_dir" 2>/dev/null)
    [[ "$dir_perms" != "755" ]] && errors=$((errors + 1))

    # chrome-sandbox setuid (4755)
    if [[ -f "$install_dir/chrome-sandbox" ]]; then
        local sandbox_perms
        sandbox_perms=$(stat -c '%a' "$install_dir/chrome-sandbox" 2>/dev/null)
        [[ "$sandbox_perms" != "4755" ]] && errors=$((errors + 1))
    fi

    # Main binary executable
    if [[ -f "$install_dir/beepertexts" && ! -x "$install_dir/beepertexts" ]]; then
        errors=$((errors + 1))
    fi

    if [[ $errors -gt 0 ]]; then
        fail "Found $errors permission issues"
        return 1
    fi

    pass "Permissions correct"
    return 0
}

verify_disk_space() {
    local target_dir="$1"
    local required_mb="$2"

    local available_mb
    available_mb=$(df -m "$target_dir" 2>/dev/null | awk 'NR==2 {print $4}')

    if [[ -z "$available_mb" ]]; then
        warn "Could not check disk space for $target_dir"
        return 0
    fi

    if [[ $available_mb -lt $required_mb ]]; then
        check_add "disk:$target_dir" "fail" "${available_mb}MB available, need ${required_mb}MB"
        return 1
    fi
    check_add "disk:$target_dir" "pass"
    return 0
}

verify_download() {
    local file="$1"
    local size
    size=$(stat -c%s "$file" 2>/dev/null || echo 0)

    if [[ $size -lt $MIN_APPIMAGE_SIZE ]]; then
        fail "Download too small: ${size} bytes (expected >150MB)"
        return 1
    fi
    pass "Download complete — $((size / 1024 / 1024))MB"
    return 0
}

verify_checksum() {
    local file="$1"
    local version="$2"

    if [[ "$SKIP_CHECKSUM" == true ]]; then
        warn "Checksum skipped (--skip-checksum)"
        return 0
    fi

    mkdir -p "$(dirname "$CHECKSUM_CACHE")"

    local actual_hash
    actual_hash=$(sha256sum "$file" | cut -d' ' -f1)

    if [[ -z "$actual_hash" ]]; then
        fail "Failed to calculate checksum"
        return 1
    fi

    local expected_hash
    expected_hash=$(grep "^$version " "$CHECKSUM_CACHE" 2>/dev/null | cut -d' ' -f2)

    if [[ -z "$expected_hash" ]]; then
        echo "$version $actual_hash" >> "$CHECKSUM_CACHE"
        pass "Checksum recorded: ${actual_hash:0:16}... (first run)"
        return 0
    fi

    if [[ "$actual_hash" == "$expected_hash" ]]; then
        pass "Checksum verified: ${actual_hash:0:16}..."
        return 0
    else
        fail "Checksum mismatch — file may be corrupted"
        hint "Use --skip-checksum to bypass"
        return 1
    fi
}

verify_extraction() {
    local extract_dir="$1"
    local critical_files=("beepertexts" "snapshot_blob.bin" "v8_context_snapshot.bin" "resources/app/package.json")

    if [[ ! -d "$extract_dir" ]]; then
        fail "Extraction failed — squashfs-root not found"
        return 1
    fi

    for f in "${critical_files[@]}"; do
        if [[ ! -f "$extract_dir/$f" ]]; then
            fail "Extraction incomplete — missing: $f"
            return 1
        fi
    done
    pass "All critical files present"
    return 0
}

verify_binary_type() {
    local binary="$1"

    if ! command -v file &>/dev/null; then
        warn "'file' command not found, skipping binary check"
        return 0
    fi

    local file_type
    file_type=$(file -b "$binary" 2>/dev/null)

    if echo "$file_type" | grep -q "ELF.*executable\|ELF.*shared object"; then
        pass "Binary verified: ELF executable"
        return 0
    else
        fail "Unexpected binary type: $file_type"
        return 1
    fi
}

verify_installed_version() {
    local expected_version="$1"
    local package_json="$INSTALL_DIR/resources/app/package.json"

    if [[ ! -f "$package_json" ]]; then
        fail "package.json not found after install"
        return 1
    fi

    local actual_version
    actual_version=$(grep -oP '"version":\s*"\K[0-9]+\.[0-9]+\.[0-9]+' "$package_json" | head -1)

    if [[ "$actual_version" == "$expected_version" ]]; then
        pass "Version verified: $actual_version"
        return 0
    else
        fail "Version mismatch — expected: $expected_version, got: $actual_version"
        return 1
    fi
}

verify_beeper_starts() {
    if [[ -z "$DISPLAY" ]] && [[ -z "$WAYLAND_DISPLAY" ]]; then
        warn "No display detected, skipping startup test"
        return 0
    fi

    pkill beepertexts 2>/dev/null || true
    sleep 2

    local launch_cmd="beeper"
    if [[ -n "$WAYLAND_DISPLAY" ]]; then
        launch_cmd="$INSTALL_DIR/beepertexts $WAYLAND_FLAGS"
    fi

    nohup $launch_cmd >/tmp/beeper-verify.log 2>&1 &
    local beeper_pid=$!

    local prev_wait=0
    for wait_time in 3 6 10; do
        sleep $((wait_time - prev_wait))
        prev_wait=$wait_time

        if ! kill -0 $beeper_pid 2>/dev/null; then
            fail "Beeper crashed within ${wait_time}s"
            return 1
        fi
    done

    if pgrep -x "beepertexts" >/dev/null; then
        pass "Beeper running stable after 10s"
        return 0
    else
        fail "Beeper process disappeared"
        return 1
    fi
}

#──────────────────────────────────────────────────────────────────────────────
# FIX & RECOVERY FUNCTIONS
#──────────────────────────────────────────────────────────────────────────────

clear_electron_cache() {
    action "Clearing Electron cache"
    rm -rf "$BEEPER_CONFIG/Cache" 2>/dev/null || true
    rm -rf "$BEEPER_CONFIG/GPUCache" 2>/dev/null || true
    rm -rf "$BEEPER_CONFIG/Code Cache" 2>/dev/null || true
    rm -rf "$BEEPER_CONFIG/DawnCache" 2>/dev/null || true
}

fix_and_retry() {
    local failure_type="$1"
    local attempt="$2"

    action "Fixing: $failure_type (attempt $attempt)"

    case "$failure_type" in
        download)
            action "Clearing temp and freeing space"
            rm -rf "$TMP_DIR"
            rm -rf /tmp/beeper-update 2>/dev/null || true
            mkdir -p "$TMP_DIR"

            local available
            available=$(df -m /tmp 2>/dev/null | awk 'NR==2 {print $4}')
            detail "Available after cleanup: ${available:-unknown}MB"
            sleep 2
            ;;
        extraction)
            action "Cleaning extraction artifacts"
            rm -rf "$TMP_DIR/squashfs-root"
            # Clean any partial extractions from previous runs
            rm -rf /tmp/beeper-update/squashfs-root 2>/dev/null || true

            # Check if disk space is the issue
            local available
            available=$(df -m /tmp 2>/dev/null | awk 'NR==2 {print $4}')
            if [[ -n "$available" ]] && [[ $available -lt 300 ]]; then
                warn "Low disk space (${available}MB) — likely causing failures"
                action "Freeing space"
                rm -rf /tmp/beeper-*.log 2>/dev/null || true
                rm -rf "$BEEPER_CONFIG/Cache" 2>/dev/null || true
                available=$(df -m /tmp 2>/dev/null | awk 'NR==2 {print $4}')
                detail "Available after cleanup: ${available:-unknown}MB"
            fi
            sleep 1
            ;;
        version)
            action "Version mismatch — clearing for fresh download"
            rm -rf "$TMP_DIR"
            rm -rf /tmp/beeper-update 2>/dev/null || true
            mkdir -p "$TMP_DIR"
            ;;
        startup)
            action "Clearing Electron caches"
            clear_electron_cache
            action "Re-applying permissions"
            sudo chown -R root:root "$INSTALL_DIR" 2>/dev/null || true
            sudo chmod 755 "$INSTALL_DIR" 2>/dev/null || true
            sudo chmod 4755 "$INSTALL_DIR/chrome-sandbox" 2>/dev/null || true
            sleep 2
            ;;
        permissions)
            action "Fixing file permissions (recursive)"
            sudo chown -R root:root "$INSTALL_DIR"
            # Fix ALL directories to 755
            sudo find "$INSTALL_DIR" -type d -exec chmod 755 {} \; 2>/dev/null || true
            # Fix chrome-sandbox setuid
            sudo chmod 4755 "$INSTALL_DIR/chrome-sandbox" 2>/dev/null || true
            # Fix executables
            sudo chmod 755 "$INSTALL_DIR/beepertexts" 2>/dev/null || true
            sudo chmod 755 "$INSTALL_DIR/AppRun" 2>/dev/null || true
            sudo chmod 755 "$INSTALL_DIR"/*.so 2>/dev/null || true
            sudo chmod 755 "$INSTALL_DIR/chrome_crashpad_handler" 2>/dev/null || true
            ;;
    esac
}

backup_current() {
    if [[ -d "$INSTALL_DIR" ]]; then
        sudo mkdir -p "$BACKUP_DIR"
        ROLLBACK_BACKUP="beeper-backup-$(date +%Y%m%d-%H%M%S)"
        action "Creating backup: $ROLLBACK_BACKUP"
        sudo cp -a "$INSTALL_DIR" "$BACKUP_DIR/$ROLLBACK_BACKUP"

        # Keep only last 3 backups (safer: use find with -maxdepth to avoid descending)
        # Delete backup directories older than the 3rd newest
        local backup_count
        backup_count=$(find "$BACKUP_DIR" -maxdepth 1 -type d -name 'beeper-backup-*' | wc -l)

        if [[ $backup_count -gt 3 ]]; then
            # Get list of backups sorted by modification time, skip newest 3
            find "$BACKUP_DIR" -maxdepth 1 -type d -name 'beeper-backup-*' -printf '%T@ %p\n' | \
                sort -n | head -n -3 | cut -d' ' -f2- | \
                while read -r old_backup; do
                    sudo rm -rf "$old_backup"
                done
        fi
    fi
}

rollback_to_backup() {
    action "Rolling back to previous version"

    local backup_to_restore=""

    if [[ -n "$ROLLBACK_BACKUP" ]] && [[ -d "$BACKUP_DIR/$ROLLBACK_BACKUP" ]]; then
        backup_to_restore="$BACKUP_DIR/$ROLLBACK_BACKUP"
    else
        backup_to_restore=$(ls -td "$BACKUP_DIR"/*/ 2>/dev/null | head -1)
    fi

    if [[ -z "$backup_to_restore" ]] || [[ ! -d "$backup_to_restore" ]]; then
        fail "No backup available for rollback"
        return 1
    fi

    action "Restoring from: $(basename "$backup_to_restore")"
    sudo rm -rf "$INSTALL_DIR"
    sudo cp -a "$backup_to_restore" "$INSTALL_DIR"

    if verify_beeper_starts; then
        pass "Rollback successful"

        local rollback_version
        rollback_version=$(grep -oP '"version":\s*"\K[0-9]+\.[0-9]+\.[0-9]+' "$INSTALL_DIR/resources/app/package.json" | head -1)
        if [[ -f /usr/share/applications/beeper.desktop ]]; then
            sudo sed -i "s/X-AppImage-Version=.*/X-AppImage-Version=$rollback_version/" \
                /usr/share/applications/beeper.desktop
        fi

        return 0
    else
        fail "Rollback failed — manual intervention required"
        return 1
    fi
}

