# Pure bash arrow-key menu selector
# Returns selected key via stdout
menu_bash() {
    local items=("${MENU_ITEMS[@]}")
    local count=${#items[@]}
    local selected=0
    local current_group=""
    local _menu_drawn=""
    local selected_key=""

    # Hide cursor, restore on any exit (return, Ctrl+C, kill)
    printf '\033[?25l' >/dev/tty
    trap 'printf "\033[?25h" >/dev/tty' RETURN
    trap 'printf "\033[?25h" >/dev/tty; return 130' INT TERM

    while true; do
        # Move cursor to top of menu area
        if [[ -n "$_menu_drawn" ]]; then
            local total_lines=$(( count + 10 ))  # items + separators + header/footer
            printf "\033[${total_lines}A" >/dev/tty
        fi
        _menu_drawn=1

        # Header
        local branch_badge=""
        [[ "$ACTIVE_BRANCH" != "stable" ]] && branch_badge=" ${INFO}[${ACTIVE_BRANCH}]${NC}"
        echo -e "" >/dev/tty
        echo -e "  ${PURPLE}${BOLD}🐝 Beeper Updater${NC} ${INFO}v${SCRIPT_VERSION}${NC}${branch_badge}" >/dev/tty
        echo -e "" >/dev/tty

        current_group=""
        local item_index=0

        for item in "${items[@]}"; do
            IFS='|' read -r ikey name desc group <<< "$item"

            # Group separator
            if [[ -n "$group" && "$group" != "$current_group" ]]; then
                current_group="$group"
                echo -e "  ${DIM}── ${current_group} ──${NC}" >/dev/tty
            elif [[ -z "$group" && -n "$current_group" ]]; then
                current_group=""
                echo -e "  ${DIM}──${NC}" >/dev/tty
            fi

            # Item (highlighted if selected)
            if (( item_index == selected )); then
                echo -e "  ${PURPLE}${BOLD}▸ ${name}${NC}" >/dev/tty
            else
                echo -e "    ${name}" >/dev/tty
            fi

            (( item_index++ )) || true
        done

        echo -e "" >/dev/tty
        echo -e "  ${DIM}↑↓ navigate  Enter select  q quit${NC}" >/dev/tty

        # Read keypress
        local input_char
        IFS= read -rsn1 input_char </dev/tty

        case "$input_char" in
            $'\x1b')  # Escape sequence
                read -rsn2 -t 0.1 input_char </dev/tty
                case "$input_char" in
                    '[A') (( selected > 0 )) && (( selected-- )) ;;          # Up
                    '[B') (( selected < count - 1 )) && (( selected++ )) ;;   # Down
                esac
                ;;
            '')  # Enter
                IFS='|' read -r selected_key _ _ _ <<< "${items[$selected]}"
                printf '\033[?25h' >/dev/tty
                echo "$selected_key"
                return 0
                ;;
            'q'|'Q')
                printf '\033[?25h' >/dev/tty
                echo "exit"
                return 0
                ;;
            [0-9])
                # Number shortcuts: 1-9 map to items 0-8, 0 = last (exit)
                local num_target
                if [[ "$input_char" == "0" ]]; then
                    num_target=$(( count - 1 ))
                else
                    num_target=$(( input_char - 1 ))
                fi
                if (( num_target >= 0 && num_target < count )); then
                    selected=$num_target
                    IFS='|' read -r selected_key _ _ _ <<< "${items[$selected]}"
                    printf '\033[?25h' >/dev/tty
                    echo "$selected_key"
                    return 0
                fi
                ;;
        esac
    done
}

