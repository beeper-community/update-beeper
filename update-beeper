# VERIFICATION FUNCTIONS
#──────────────────────────────────────────────────────────────────────────────

verify_sudo_access() {
    if ! sudo -v 2>/dev/null; then
        fail "sudo access required"
        hint "Run with sudo privileges or ensure sudo is configured"
        return 1
    fi
    check_add "sudo" "pass"
    return 0
}

verify_system_requirements() {
    local errors=0

    # Network connectivity
    if ! curl -s --connect-timeout 5 --head https://api.beeper.com >/dev/null 2>&1; then
        check_add "network" "fail" "Cannot reach Beeper servers"
        errors=$((errors + 1))
    else
        check_add "network" "pass"
    fi

    # /opt writable (with sudo)
    if ! sudo test -w /opt 2>/dev/null; then
        check_add "/opt" "fail" "not writable"
        errors=$((errors + 1))
    else
        check_add "/opt" "pass"
    fi

    # /tmp writable
    if ! test -w /tmp; then
        check_add "/tmp" "fail" "not writable"
        errors=$((errors + 1))
    else
        check_add "/tmp" "pass"
    fi

    # Required commands
    local required_cmds=("curl" "stat" "grep" "sed" "tar")
    for cmd in "${required_cmds[@]}"; do
        if ! command -v "$cmd" &>/dev/null; then
            check_add "$cmd" "fail" "not found"
            errors=$((errors + 1))
        fi
    done

    # Beeper running (warn only, doesn't count as error)
    if pgrep -x "beepertexts" >/dev/null; then
        check_add "beeper" "warn" "running, will restart after update"
    fi

    if [[ $errors -gt 0 ]]; then
        return 1
    fi
    return 0
}

verify_permissions() {
    local install_dir="$1"
    local errors=0

    if [[ ! -d "$install_dir" ]]; then
        fail "Install directory not found: $install_dir"
        return 1
    fi

    # Ownership (root:root)
    local owner
    owner=$(stat -c '%U:%G' "$install_dir" 2>/dev/null)
    [[ "$owner" != "root:root" ]] && errors=$((errors + 1))

    # Directory permissions (755)
    local dir_perms
    dir_perms=$(stat -c '%a' "$install_dir" 2>/dev/null)
    [[ "$dir_perms" != "755" ]] && errors=$((errors + 1))

    # chrome-sandbox setuid (4755)
    if [[ -f "$install_dir/chrome-sandbox" ]]; then
        local sandbox_perms
        sandbox_perms=$(stat -c '%a' "$install_dir/chrome-sandbox" 2>/dev/null)
        [[ "$sandbox_perms" != "4755" ]] && errors=$((errors + 1))
    fi

    # Main binary executable
    if [[ -f "$install_dir/beepertexts" && ! -x "$install_dir/beepertexts" ]]; then
        errors=$((errors + 1))
    fi

    if [[ $errors -gt 0 ]]; then
        fail "Found $errors permission issues"
        return 1
    fi

    pass "Permissions correct"
    return 0
}

verify_disk_space() {
    local target_dir="$1"
    local required_mb="$2"

    local available_mb
    available_mb=$(df -m "$target_dir" 2>/dev/null | awk 'NR==2 {print $4}')

    if [[ -z "$available_mb" ]]; then
        warn "Could not check disk space for $target_dir"
        return 0
    fi

    if [[ $available_mb -lt $required_mb ]]; then
        check_add "disk:$target_dir" "fail" "${available_mb}MB available, need ${required_mb}MB"
        return 1
    fi
    check_add "disk:$target_dir" "pass"
    return 0
}

verify_download() {
    local file="$1"
    local size
    size=$(stat -c%s "$file" 2>/dev/null || echo 0)

    if [[ $size -lt $MIN_APPIMAGE_SIZE ]]; then
        fail "Download too small: ${size} bytes (expected >150MB)"
        return 1
    fi
    pass "Download complete — $((size / 1024 / 1024))MB"
    return 0
}

verify_checksum() {
    local file="$1"
    local version="$2"

    if [[ "$SKIP_CHECKSUM" == true ]]; then
        warn "Checksum skipped (--skip-checksum)"
        return 0
    fi

    mkdir -p "$(dirname "$CHECKSUM_CACHE")"

    local actual_hash
    actual_hash=$(sha256sum "$file" | cut -d' ' -f1)

    if [[ -z "$actual_hash" ]]; then
        fail "Failed to calculate checksum"
        return 1
    fi

    local expected_hash
    expected_hash=$(grep "^$version " "$CHECKSUM_CACHE" 2>/dev/null | cut -d' ' -f2)

    if [[ -z "$expected_hash" ]]; then
        echo "$version $actual_hash" >> "$CHECKSUM_CACHE"
        pass "Checksum recorded: ${actual_hash:0:16}... (first run)"
        return 0
    fi

    if [[ "$actual_hash" == "$expected_hash" ]]; then
        pass "Checksum verified: ${actual_hash:0:16}..."
        return 0
    else
        fail "Checksum mismatch — file may be corrupted"
        hint "Use --skip-checksum to bypass"
        return 1
    fi
}

verify_extraction() {
    local extract_dir="$1"
    local critical_files=("beepertexts" "snapshot_blob.bin" "v8_context_snapshot.bin" "resources/app/package.json")

    if [[ ! -d "$extract_dir" ]]; then
        fail "Extraction failed — squashfs-root not found"
        return 1
    fi

    for f in "${critical_files[@]}"; do
        if [[ ! -f "$extract_dir/$f" ]]; then
            fail "Extraction incomplete — missing: $f"
            return 1
        fi
    done
    pass "All critical files present"
    return 0
}

verify_binary_type() {
    local binary="$1"

    if ! command -v file &>/dev/null; then
        warn "'file' command not found, skipping binary check"
        return 0
    fi

    local file_type
    file_type=$(file -b "$binary" 2>/dev/null)

    if echo "$file_type" | grep -q "ELF.*executable\|ELF.*shared object"; then
        pass "Binary verified: ELF executable"
        return 0
    else
        fail "Unexpected binary type: $file_type"
        return 1
    fi
}

verify_installed_version() {
    local expected_version="$1"
    local package_json="$INSTALL_DIR/resources/app/package.json"

    if [[ ! -f "$package_json" ]]; then
        fail "package.json not found after install"
        return 1
    fi

    local actual_version
    actual_version=$(grep -oP '"version":\s*"\K[0-9]+\.[0-9]+\.[0-9]+' "$package_json" | head -1)

    if [[ "$actual_version" == "$expected_version" ]]; then
        pass "Version verified: $actual_version"
        return 0
    else
        fail "Version mismatch — expected: $expected_version, got: $actual_version"
        return 1
    fi
}

verify_beeper_starts() {
    if [[ -z "$DISPLAY" ]] && [[ -z "$WAYLAND_DISPLAY" ]]; then
        warn "No display detected, skipping startup test"
        return 0
    fi

    pkill beepertexts 2>/dev/null || true
    sleep 2

    local launch_cmd="beeper"
    if [[ -n "$WAYLAND_DISPLAY" ]]; then
        launch_cmd="$INSTALL_DIR/beepertexts $WAYLAND_FLAGS"
    fi

    nohup $launch_cmd >/tmp/beeper-verify.log 2>&1 &
    local beeper_pid=$!

    local prev_wait=0
    for wait_time in 3 6 10; do
        sleep $((wait_time - prev_wait))
        prev_wait=$wait_time

        if ! kill -0 $beeper_pid 2>/dev/null; then
            fail "Beeper crashed within ${wait_time}s"
            return 1
        fi
    done

    if pgrep -x "beepertexts" >/dev/null; then
        pass "Beeper running stable after 10s"
        return 0
    else
        fail "Beeper process disappeared"
        return 1
    fi
}

