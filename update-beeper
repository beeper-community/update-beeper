#!/bin/bash
# ~/bin/update-beeper - Smart Beeper updater with self-healing
# Features: auto-retry, self-healing, health checks, automatic rollback

set -e

SCRIPT_VERSION="1.9.0"
LOCKFILE="/tmp/update-beeper.lock"
# BEEPER_API is set dynamically after branch config is read (see ACTIVE_BRANCH)
CHANGELOG_URL="https://www.beeper.com/changelog/desktop"
INSTALL_DIR="/opt/beeper"
BACKUP_DIR="/opt/beeper-backups"
TMP_DIR="/tmp/beeper-update"
BEEPER_CONFIG="$HOME/.config/BeeperTexts"
USER_DESKTOP_DIR="$HOME/.local/share/applications"
USER_DESKTOP_FILE="$USER_DESKTOP_DIR/beeper-wayland.desktop"
BUNDLED_DESKTOP="$INSTALL_DIR/beepertexts.desktop"
USER_ICON_DIR="$HOME/.local/share/icons/hicolor/512x512/apps"

# Wayland flags for native rendering (fixes blank windows on Hyprland/Sway)
# --disable-gpu-compositing prevents blank screen after sleep/wake cycles
WAYLAND_FLAGS="--enable-features=UseOzonePlatform --ozone-platform=wayland --disable-gpu-compositing"

# Minimum expected AppImage size (Beeper is ~200MB)
MIN_APPIMAGE_SIZE=150000000  # 150MB

# Checksum cache for trust-on-first-run verification
CHECKSUM_CACHE="$HOME/.cache/update-beeper/checksums.txt"

# Persistent log and update history
LOG_FILE="$HOME/.local/share/update-beeper/update-beeper.log"
HISTORY_FILE="$HOME/.local/share/update-beeper/update-history.log"

# Branch configuration
BRANCH_CONFIG_DIR="$HOME/.config/update-beeper"
BRANCH_CONFIG_FILE="$BRANCH_CONFIG_DIR/config"
BEEPER_API_TEMPLATE="https://api.beeper.com/desktop/download/linux/x64/%s/com.automattic.beeper.desktop"

read_config_branch() {
    if [[ -f "$BRANCH_CONFIG_FILE" ]]; then
        local branch
        branch=$(grep -oP '^BRANCH=\K\S+' "$BRANCH_CONFIG_FILE" 2>/dev/null)
        if [[ "$branch" =~ ^(stable|nightly|beta)$ ]]; then
            echo "$branch"
            return
        fi
    fi
    echo "stable"
}

write_config_branch() {
    mkdir -p "$BRANCH_CONFIG_DIR"
    echo "BRANCH=$1" > "$BRANCH_CONFIG_FILE"
}

ACTIVE_BRANCH=$(read_config_branch)
BEEPER_API="${BEEPER_API_TEMPLATE/\%s/$ACTIVE_BRANCH}"

#──────────────────────────────────────────────────────────────────────────────
# DATA FETCHING & CACHING (beeper-intel)
#──────────────────────────────────────────────────────────────────────────────

INTEL_RAW_URL="https://raw.githubusercontent.com/robertogogoni/beeper-intel/main/data"
CACHE_DIR="$HOME/.cache/update-beeper"
CACHE_TTL_SECONDS=21600  # 6 hours

# Ensure cache directory exists
mkdir -p "$CACHE_DIR" 2>/dev/null || true

# Fetch data with local cache. Returns cached content if within TTL.
# Usage: fetch_cached_data "branch-versions"  →  prints JSON to stdout
fetch_cached_data() {
    local name="$1"
    local cache_file="$CACHE_DIR/${name}.json"
    local url="${INTEL_RAW_URL}/${name}.json"

    # Check cache freshness
    if [[ -f "$cache_file" ]]; then
        local cache_age=$(( $(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || echo 0) ))
        if (( cache_age < CACHE_TTL_SECONDS )); then
            cat "$cache_file"
            return 0
        fi
    fi

    # Fetch fresh data
    local data
    data=$(curl -sL -m 10 "$url" 2>/dev/null)
    if [[ -n "$data" ]] && [[ "${data:0:1}" == "{" ]] && [[ "${data: -1}" == "}" ]]; then
        echo "$data" > "${cache_file}.tmp" && mv -f "${cache_file}.tmp" "$cache_file"
        echo "$data"
        return 0
    fi

    # Fallback to stale cache
    if [[ -f "$cache_file" ]]; then
        cat "$cache_file"
        return 0
    fi

    return 1
}

# Get human-readable cache age for display
cache_age_display() {
    local name="$1"
    local cache_file="$CACHE_DIR/${name}.json"
    if [[ -f "$cache_file" ]]; then
        local age=$(( $(date +%s) - $(stat -c %Y "$cache_file" 2>/dev/null || echo 0) ))
        if (( age < 60 )); then echo "just now"
        elif (( age < 3600 )); then echo "$((age / 60))m ago"
        elif (( age < 86400 )); then echo "$((age / 3600))h ago"
        else echo "$((age / 86400))d ago"
        fi
    else
        echo "never"
    fi
}

# Minimum required free space (500MB for download + extraction + buffer)
MIN_FREE_SPACE_MB=500

# Retry limits
MAX_DOWNLOAD_RETRIES=2
MAX_EXTRACTION_RETRIES=2
MAX_STARTUP_RETRIES=2

# Runtime dependencies that Beeper needs but pacman won't track after
# deregistration. Without this, orphan cleanup (pacman -Rns $(pacman -Qdtq))
# can silently remove these, breaking tray icons, notifications, etc.
BEEPER_RUNTIME_DEPS=(libappindicator libnotify libsecret hicolor-icon-theme)

# ── Beeper Brand Colors (True Color) ─────────────────────────────────────
# Primary brand: purple #6953f2, secondary: blue #0c52f9
if [[ "$COLORTERM" == "truecolor" || "$COLORTERM" == "24bit" ]]; then
    PURPLE='\033[38;2;105;83;242m'      # #6953f2 Beeper primary
    BLUE='\033[38;2;12;82;249m'         # #0c52f9 Beeper secondary
    OK='\033[38;2;80;200;120m'          # #50c878 muted emerald (success)
    ERR='\033[38;2;235;87;87m'          # #eb5757 soft red (errors)
    WARN='\033[38;2;242;201;76m'        # #f2c94c warm amber (warnings)
    INFO='\033[38;2;130;130;160m'       # #8282a0 lavender-gray (dim info)
    ACCENT='\033[38;2;160;140;255m'     # #a08cff light purple (labels)
else
    # 256-color fallback
    PURPLE='\033[38;5;99m'
    BLUE='\033[38;5;27m'
    OK='\033[38;5;78m'
    ERR='\033[38;5;167m'
    WARN='\033[38;5;220m'
    INFO='\033[38;5;103m'
    ACCENT='\033[38;5;141m'
fi
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Dynamic Box Width ────────────────────────────────────────────────────
# Responsive to terminal size, clamped between 36-56 inner chars
BOX_WIDTH=$(( $(tput cols 2>/dev/null || echo 80) - 6 ))
(( BOX_WIDTH > 56 )) && BOX_WIDTH=56
(( BOX_WIDTH < 36 )) && BOX_WIDTH=36

# Flags
CHECK_ONLY=false
NOTIFY=false
FORCE=false
SHOW_CHANGELOG=false
QUIET=false
DO_ROLLBACK=false
SCRIPT_EXIT_CODE=0
SHOW_VERSIONS=false
SKIP_CHECKSUM=false
DRY_RUN=false
CHECK_DESKTOP=false
SHOW_WHATS_NEW=false
SHOW_MENU=false
SET_BRANCH=""
SHOW_BRANCH=false

# Track which backup to use for rollback
ROLLBACK_BACKUP=""

usage() {
    echo "Usage: update-beeper [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  --check, -c       Check for updates without installing"
    echo "  --changelog, -l   Show changelog for installed version"
    echo "  --notify, -n      Send desktop notification (for cron/timer use)"
    echo "  --force, -f       Force update even if already on latest"
    echo "  --quiet, -q       Quiet mode - only output on errors (for cron/systemd)"
    echo "  --versions        Show all version info (installed, latest, AUR)"
    echo "  --skip-checksum   Skip SHA256 checksum verification (for forced re-downloads)"
    echo "  --dry-run         Show what would happen without making changes"
    echo "  --history         Show update history"
    echo "  --check-desktop   Validate Beeper desktop shortcut and icon"
    echo "  --rollback, -r    Rollback to previous backup version"
    echo "  --version, -v     Show script version"
    echo "  --branch [NAME]   Set or show active branch (stable, nightly)"
    echo "  --whats-new, -w   Show changes since installed version"
    echo "  --menu, -m        Force interactive menu"
    echo "  --help, -h        Show this help message"
    echo ""
    echo "Beeper will automatically restart after updating."
    echo "If update fails, automatic rollback will restore the previous version."
    echo ""
    echo "Wayland Support:"
    echo "  On Wayland (Hyprland, Sway, etc.), this script automatically:"
    echo "  - Creates ~/.local/share/applications/beeper-wayland.desktop"
    echo "  - Installs icon to hicolor theme for launcher display"
    echo "  - Validates desktop entry points to correct binary and version"
    echo "  - Cleans up stale Beeper shortcuts"
    exit 0
}

show_version() {
    echo "update-beeper $SCRIPT_VERSION"
    exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --check|-c) CHECK_ONLY=true; shift ;;
        --changelog|-l) SHOW_CHANGELOG=true; shift ;;
        --notify|-n) NOTIFY=true; shift ;;
        --force|-f) FORCE=true; shift ;;
        --quiet|-q) QUIET=true; shift ;;
        --versions) SHOW_VERSIONS=true; shift ;;
        --skip-checksum) SKIP_CHECKSUM=true; shift ;;
        --dry-run) DRY_RUN=true; shift ;;
        --history) cat "$HISTORY_FILE" 2>/dev/null || echo "No update history yet."; exit 0 ;;
        --check-desktop) CHECK_DESKTOP=true; shift ;;
        --rollback|-r) DO_ROLLBACK=true; shift ;;
        --version|-v) show_version ;;
        --help|-h) usage ;;
        --branch)
            if [[ -n "${2:-}" ]] && [[ "$2" =~ ^(stable|nightly|beta)$ ]]; then
                SET_BRANCH="$2"; shift 2
            elif [[ -n "${2:-}" ]] && [[ "$2" != --* ]]; then
                echo "Unknown branch: $2 (valid: stable, nightly, beta)"; exit 1
            else
                SHOW_BRANCH=true; shift
            fi
            ;;
        --whats-new|-w) SHOW_WHATS_NEW=true; shift ;;
        --menu|-m) SHOW_MENU=true; shift ;;
        *) echo "Unknown option: $1"; usage ;;
    esac
done

cleanup() {
    printf '\033[?25h' >/dev/tty 2>/dev/null || true  # Restore cursor if hidden by menu
    sudo_keepalive_stop
    rm -rf "$TMP_DIR" 2>/dev/null || true
    release_lock
}
trap cleanup EXIT

#──────────────────────────────────────────────────────────────────────────────
# LOCKFILE MANAGEMENT
#──────────────────────────────────────────────────────────────────────────────

acquire_lock() {
    # Use file descriptor 9 for the lock
    exec 9>"$LOCKFILE"
    if ! flock -n 9; then
        local other_pid
        other_pid=$(cat "$LOCKFILE" 2>/dev/null || echo "unknown")
        fail "Another update-beeper is already running (PID: $other_pid)"
        exit 1
    fi
    echo $$ > "$LOCKFILE"
}

release_lock() {
    flock -u 9 2>/dev/null || true
    rm -f "$LOCKFILE" 2>/dev/null || true
}

#──────────────────────────────────────────────────────────────────────────────
# OUTPUT HELPERS (for quiet mode)
#──────────────────────────────────────────────────────────────────────────────

# Print only if not in quiet mode
log() {
    [[ "$QUIET" != true ]] && echo -e "$@" || true
}

# Always print (errors)
log_error() {
    echo -e "$@" >&2
}

#──────────────────────────────────────────────────────────────────────────────
# UI SYSTEM — Beeper-branded output hierarchy
#──────────────────────────────────────────────────────────────────────────────

# Step counter for progress tracking
CURRENT_STEP=0
TOTAL_STEPS=8
START_TIME=$SECONDS
UPDATE_METHOD=""
RETRIES_USED=""

print_header() {
    log ""
    log "  ${PURPLE}${BOLD}🐝 Beeper Updater${NC} ${INFO}v${SCRIPT_VERSION}${NC}"
    log ""
}

# Phase header: [n/N] Title
phase() {
    local step="$1" total="$2" title="$3"
    log ""
    log "  ${PURPLE}${BOLD}[${step}/${total}]${NC} ${BOLD}${title}${NC}"
}

next_phase() {
    CURRENT_STEP=$((CURRENT_STEP + 1))
    phase "$CURRENT_STEP" "$TOTAL_STEPS" "$1"
}

# Sub-step results (4-space indent)
pass()   { log "    ${OK}✓${NC} $1"; }
fail()   { log_error "    ${ERR}✗${NC} $1"; }
warn()   { log "    ${WARN}!${NC} $1"; }
detail() { log "    ${INFO}$1${NC}"; }
action() { log "    ${ACCENT}→${NC} $1"; }
hint()   { log "      ${INFO}$1${NC}"; }

#──────────────────────────────────────────────────────────────────────────────
# COLLAPSIBLE CHECK GROUPS
#──────────────────────────────────────────────────────────────────────────────

declare -a _check_results=()
declare -a _check_names=()
_check_failures=0

check_reset() {
    _check_results=()
    _check_names=()
    _check_failures=0
}

check_add() {
    local name="$1" status="$2" msg="${3:-}"
    _check_names+=("$name")
    _check_results+=("${status}|${name}|${msg}")
    if [[ "$status" == "fail" ]]; then
        _check_failures=$((_check_failures + 1))
    fi
}

check_flush() {
    if [[ $_check_failures -eq 0 && ${#_check_results[@]} -gt 2 ]]; then
        # Collapse: all passed
        local names_joined
        names_joined=$(IFS=', '; echo "${_check_names[*]}")
        pass "All ${#_check_results[@]} checks passed (${names_joined})"
    else
        # Expand: show each
        local entry status name msg
        for entry in "${_check_results[@]}"; do
            IFS='|' read -r status name msg <<< "$entry"
            case "$status" in
                pass) pass "$name" ;;
                warn) warn "$name${msg:+ — $msg}" ;;
                fail) fail "$name${msg:+ — $msg}" ;;
            esac
        done
    fi
    check_reset
}

#──────────────────────────────────────────────────────────────────────────────
# BOX RENDERING PRIMITIVES
#──────────────────────────────────────────────────────────────────────────────

# Strip ANSI escape codes to get visible character count
strip_ansi() {
    echo -e "$1" | sed 's/\x1b\[[0-9;]*m//g'
}

# Top border: ╭──── [optional title] ─╮
box_top() {
    local title="$1"
    if [[ -n "$title" ]]; then
        local visible
        visible=$(strip_ansi "$title")
        local title_len=${#visible}
        local bar_len=$(( BOX_WIDTH - title_len - 4 ))
        (( bar_len < 1 )) && bar_len=1
        log "  ${INFO}╭─$(printf '─%.0s' $(seq 1 $bar_len)) ${NC}${title}${INFO} ─╮${NC}"
    else
        log "  ${INFO}╭$(printf '─%.0s' $(seq 1 $BOX_WIDTH))╮${NC}"
    fi
}

# Bottom border: ╰──────────────────╯
box_bottom() {
    log "  ${INFO}╰$(printf '─%.0s' $(seq 1 $BOX_WIDTH))╯${NC}"
}

# Content row: │ content      │  (ANSI-safe padding)
box_row() {
    local content="$1"
    local inner_width=$(( BOX_WIDTH - 2 ))
    local visible
    visible=$(strip_ansi "$content")
    local vlen=${#visible}
    local pad=$(( inner_width - vlen ))
    (( pad < 0 )) && pad=0
    log "  ${INFO}│${NC} ${content}$(printf '%*s' "$pad" '') ${INFO}│${NC}"
}

# Empty row: │               │
box_blank() {
    log "  ${INFO}│${NC}$(printf '%*s' $(( BOX_WIDTH )) '')${INFO}│${NC}"
}

# Separator: ├── label ──────┤  or  ├──────────────┤
box_sep() {
    local label="$1"
    if [[ -n "$label" ]]; then
        local visible
        visible=$(strip_ansi "$label")
        local label_len=${#visible}
        local bar_len=$(( BOX_WIDTH - label_len - 4 ))
        (( bar_len < 1 )) && bar_len=1
        log "  ${INFO}├── ${DIM}${label}${NC}${INFO} $(printf '─%.0s' $(seq 1 $bar_len))┤${NC}"
    else
        log "  ${INFO}├$(printf '─%.0s' $(seq 1 $BOX_WIDTH))┤${NC}"
    fi
}

# Backward compat: pad_row is now an alias for box_row
pad_row() { box_row "$@"; }

summary_box() {
    local status="$1"  # "success" or "failure"
    local elapsed=$((SECONDS - START_TIME))
    local duration
    if [[ $elapsed -ge 60 ]]; then
        duration="$((elapsed / 60))m $((elapsed % 60))s"
    else
        duration="${elapsed}s"
    fi

    log ""
    box_top

    if [[ "$status" == "success" ]]; then
        box_row "${OK}${BOLD}✓ Update complete${NC}"
    else
        box_row "${ERR}${BOLD}✗ Update failed${NC}"
    fi

    box_blank
    box_row "${ACCENT}Version${NC}   ${INSTALLED:-?} → ${LATEST}"
    box_row "${ACCENT}Method${NC}    ${UPDATE_METHOD:-Direct install}"
    box_row "${ACCENT}Duration${NC}  ${duration}"

    if [[ -n "$RETRIES_USED" ]]; then
        box_row "${ACCENT}Retries${NC}   ${RETRIES_USED}"
    fi

    # Wayland row (only on Wayland)
    if [[ -n "$WAYLAND_DISPLAY" ]]; then
        box_row "${ACCENT}Wayland${NC}   Configured"
    fi

    # Desktop entry status
    if [[ -f "$USER_DESKTOP_FILE" ]]; then
        box_row "${ACCENT}Desktop${NC}   $(basename "$USER_DESKTOP_FILE")"
    fi

    # Rollback row (only on failure with rollback)
    if [[ "$status" == "failure" && -n "$2" ]]; then
        box_row "${ACCENT}Action${NC}    $2"
    fi

    box_bottom
    log ""
}

# Persistent log file (fire-and-forget, never fails the script)
log_event() {
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG_FILE" 2>/dev/null || true
}

# Record update in history file
record_update_history() {
    local from_version="$1"
    local to_version="$2"
    local method="$3"    # "aur" or "direct"
    local status="$4"    # "success" or "failed" or "rolled-back"
    mkdir -p "$(dirname "$HISTORY_FILE")" 2>/dev/null || true
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $from_version → $to_version ($method) [$status]" >> "$HISTORY_FILE" 2>/dev/null || true
}

#──────────────────────────────────────────────────────────────────────────────
# SUDO KEEPALIVE (prevents timeout during long downloads)
#──────────────────────────────────────────────────────────────────────────────

SUDO_KEEPALIVE_PID=""

sudo_keepalive_start() {
    ( while true; do sudo -v 2>/dev/null; sleep 50; done ) &
    SUDO_KEEPALIVE_PID=$!
}

sudo_keepalive_stop() {
    if [[ -n "${SUDO_KEEPALIVE_PID}" ]]; then
        kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
        wait "$SUDO_KEEPALIVE_PID" 2>/dev/null || true
        SUDO_KEEPALIVE_PID=""
    fi
}

#──────────────────────────────────────────────────────────────────────────────
# SYSTEM COMPATIBILITY CHECKS
#──────────────────────────────────────────────────────────────────────────────

check_architecture() {
    local arch
    arch=$(uname -m)
    if [[ "$arch" != "x86_64" ]]; then
        fail "Unsupported architecture: $arch"
        hint "Beeper Desktop only provides x86_64 (64-bit) builds"
        exit 1
    fi
}

check_distro() {
    if ! command -v pacman &>/dev/null; then
        warn "Designed for Arch Linux — pacman not found"
        hint "AUR features won't be available"
    fi
}

check_dependencies() {
    local missing=()

    for cmd in curl sudo; do
        if ! command -v "$cmd" &>/dev/null; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -gt 0 ]]; then
        fail "Missing required dependencies: ${missing[*]}"
        hint "Install with: sudo pacman -S ${missing[*]}"
        exit 1
    fi

    if ! command -v notify-send &>/dev/null; then
        if [[ "$NOTIFY" == true ]]; then
            NOTIFY=false
        fi
    fi
}

check_system_compatibility() {
    check_architecture
    check_distro
    check_dependencies
}

#──────────────────────────────────────────────────────────────────────────────
# UTILITY FUNCTIONS
#──────────────────────────────────────────────────────────────────────────────

# Version comparison: returns 0 if $1 >= $2
version_gte() {
    printf '%s\n%s\n' "$2" "$1" | sort -V -C
}

send_notification() {
    if command -v notify-send &>/dev/null; then
        notify-send -i beepertexts "Beeper Update" "$1"
    fi
}

show_changelog() {
    local data
    data=$(fetch_cached_data "desktop-changelog" 2>/dev/null)

    if [[ -z "$data" ]] || ! command -v jq &>/dev/null; then
        # Fallback: open browser (original behavior)
        local version=""
        if [[ -f "$INSTALL_DIR/resources/app/package.json" ]]; then
            version=$(grep -oP '"version":\s*"\K[0-9]+\.[0-9]+\.[0-9]+' "$INSTALL_DIR/resources/app/package.json" | head -1)
        fi
        print_header
        log "  ${ACCENT}Changelog${NC}"
        log ""
        detail "Opening in browser..."
        if command -v xdg-open &>/dev/null; then
            xdg-open "$CHANGELOG_URL" 2>/dev/null &
        elif command -v open &>/dev/null; then
            open "$CHANGELOG_URL" 2>/dev/null &
        else
            warn "Could not open browser"
            detail "Visit: ${CHANGELOG_URL}"
        fi
        hint "Cached changelog data not available. Install jq for in-terminal display."
        return 0
    fi

    # Parse and display changelog entries
    local output=""
    local count
    count=$(echo "$data" | jq '.versions | length // 0' 2>/dev/null) || count=0

    print_header
    log "  ${ACCENT}${BOLD}Changelog${NC} — ${INFO}${count} versions${NC}  ${DIM}(checked $(cache_age_display "desktop-changelog"))${NC}"
    log ""

    local i=0
    while (( i < count )); do
        local ver date
        ver=$(echo "$data" | jq -r ".versions[$i].version" | sed 's/^v//')
        date=$(echo "$data" | jq -r ".versions[$i].date // \"\"")

        log "  ${BOLD}${ver}${NC}${date:+ ${DIM}(${date})${NC}}"

        # New features
        local feat_count
        feat_count=$(echo "$data" | jq ".versions[$i].new_features | length // 0" 2>/dev/null) || feat_count=0
        local f=0
        while (( f < feat_count )); do
            local feat
            feat=$(echo "$data" | jq -r ".versions[$i].new_features[$f]")
            log "    ${OK}✨${NC} ${feat}"
            (( f++ ))
        done

        # Fixes
        local fix_count
        fix_count=$(echo "$data" | jq ".versions[$i].fixes | length // 0" 2>/dev/null) || fix_count=0
        local x=0
        while (( x < fix_count )); do
            local fix
            fix=$(echo "$data" | jq -r ".versions[$i].fixes[$x]")
            log "    ${WARN}🐛${NC} ${fix}"
            (( x++ ))
        done

        log ""
        (( i++ ))
    done

    return 0
}

show_whats_new() {
    local installed=""
    if [[ -f "$INSTALL_DIR/resources/app/package.json" ]]; then
        installed=$(grep -oP '"version":\s*"\K[0-9]+\.[0-9]+\.[0-9]+' "$INSTALL_DIR/resources/app/package.json" | head -1)
    fi

    if [[ -z "$installed" ]]; then
        fail "Could not determine installed version"
        return 1
    fi

    # Also get branch data for latest version
    local branch_data latest_ver
    branch_data=$(fetch_cached_data "branch-versions" 2>/dev/null)
    if [[ -n "$branch_data" ]] && command -v jq &>/dev/null; then
        latest_ver=$(echo "$branch_data" | jq -r ".branches.${ACTIVE_BRANCH}.version // \"unknown\"")
    fi
    [[ -z "$latest_ver" || "$latest_ver" == "null" ]] && latest_ver="unknown"

    print_header

    if version_gte "$installed" "${latest_ver:-0}"; then
        log ""
        box_top
        box_row "${OK}${BOLD}✓ You're up to date${NC}"
        box_blank
        box_row "${ACCENT}Installed${NC}   ${installed} (${ACTIVE_BRANCH})"
        box_row "${ACCENT}Latest${NC}      ${latest_ver}"
        box_bottom
        log ""
        return 0
    fi

    # Build "what's new" from changelog data
    local changelog
    changelog=$(fetch_cached_data "desktop-changelog" 2>/dev/null)

    log ""
    box_top "What's New"
    box_row "${ACCENT}You${NC}  ${installed} → ${ACCENT}Latest${NC}  ${BOLD}${latest_ver}${NC} (${ACTIVE_BRANCH})"
    box_blank

    if [[ -n "$changelog" ]] && command -v jq &>/dev/null; then
        local features=() fixes=() versions_spanned=0
        local count
        count=$(echo "$changelog" | jq '.versions | length // 0' 2>/dev/null) || count=0

        local i=0
        while (( i < count )); do
            local ver
            ver=$(echo "$changelog" | jq -r ".versions[$i].version" | sed 's/^v//')
            # Include versions newer than installed
            if [[ "$ver" != "$installed" ]] && ! version_gte "$installed" "$ver"; then
                (( versions_spanned++ ))

                local feat_count
                feat_count=$(echo "$changelog" | jq ".versions[$i].new_features | length // 0" 2>/dev/null) || feat_count=0
                local f=0
                while (( f < feat_count )); do
                    features+=("$(echo "$changelog" | jq -r ".versions[$i].new_features[$f]")")
                    (( f++ ))
                done

                local fix_count
                fix_count=$(echo "$changelog" | jq ".versions[$i].fixes | length // 0" 2>/dev/null) || fix_count=0
                local x=0
                while (( x < fix_count )); do
                    fixes+=("$(echo "$changelog" | jq -r ".versions[$i].fixes[$x]")")
                    (( x++ ))
                done
            fi
            # Stop once we pass our installed version
            if [[ "$ver" == "$installed" ]] || version_gte "$installed" "$ver"; then
                break
            fi
            (( i++ ))
        done

        if (( ${#features[@]} > 0 )); then
            box_sep "New Features"
            for feat in "${features[@]}"; do
                box_row "  ${OK}✨${NC} ${feat}"
            done
        fi

        if (( ${#fixes[@]} > 0 )); then
            box_sep "Fixes"
            for fix in "${fixes[@]}"; do
                box_row "  ${WARN}🐛${NC} ${fix}"
            done
        fi

        if (( versions_spanned > 1 )); then
            box_blank
            box_row "${DIM}Spans ${versions_spanned} versions${NC}"
        fi
    else
        box_row "${INFO}Changelog data not available${NC}"
        box_row "${INFO}Install jq and wait for beeper-intel refresh${NC}"
    fi

    box_bottom
    log ""
    return 0
}

